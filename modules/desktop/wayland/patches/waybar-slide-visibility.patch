+void waybar::Bar::animateVisibility(bool should_show) {
+  if (!config["slide-duration"].isUInt() || position != Gtk::POS_BOTTOM) {
+    return;
+  }
+
+  if (slide_connection_.connected()) {
+    slide_connection_.disconnect();
+  }
+
+  const auto duration = std::chrono::milliseconds(config["slide-duration"].asUInt());
+  const auto started_at = std::chrono::steady_clock::now();
+  const auto offset = config["slide-offset"].isInt() ? config["slide-offset"].asInt() : 0;
+  const auto target = should_show ? margins_.bottom : -static_cast<int>(height_) - offset;
+  const auto start = slide_margin_;
+
+  slide_connection_ = Glib::signal_timeout().connect(
+      [this, duration, started_at, start, target] {
+        const auto elapsed = std::chrono::steady_clock::now() - started_at;
+        const auto linear_progress = std::min(1.0, std::chrono::duration<double>(elapsed).count() /
+                                                       std::chrono::duration<double>(duration).count());
+        const auto progress = 1.0 - std::pow(1.0 - linear_progress, 3);
+        slide_margin_ = static_cast<int>(start + (target - start) * progress);
+        gtk_layer_set_margin(window.gobj(), GTK_LAYER_SHELL_EDGE_BOTTOM, slide_margin_);
+        gtk_layer_try_force_commit(window.gobj());
+        wl_display_flush(Client::inst()->wl_display);
+        return progress < 1.0;
+      },
+      16);
+}
+
 void waybar::Bar::toggle() { setVisible(!visible); }
 void waybar::Bar::show() { setVisible(true); }
 void waybar::Bar::hide() { setVisible(false); }
