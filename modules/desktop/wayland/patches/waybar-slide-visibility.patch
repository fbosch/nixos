+void waybar::Bar::animateVisibility(bool should_show) {
+  if (!config["slide-duration"].isUInt() || !config["slide-ease-out-exponent"].isNumeric() ||
+      config["slide-ease-out-exponent"].asDouble() < 1.0 || position != Gtk::POS_BOTTOM) {
+    return;
+  }
+
+  if (slide_tick_callback_ != 0) {
+    gtk_widget_remove_tick_callback(GTK_WIDGET(window.gobj()), slide_tick_callback_);
+    slide_tick_callback_ = 0;
+  }
+
+  slide_duration_ = static_cast<gint64>(config["slide-duration"].asUInt()) * G_TIME_SPAN_MILLISECOND;
+  slide_ease_out_exponent_ = config["slide-ease-out-exponent"].asDouble();
+  slide_started_at_ = 0;
+  const auto offset = config["slide-offset"].isInt() ? config["slide-offset"].asInt() : 0;
+  slide_target_ = should_show ? margins_.bottom : -static_cast<int>(height_) - offset;
+  slide_start_ = slide_margin_;
+
+  slide_tick_callback_ = gtk_widget_add_tick_callback(
+      GTK_WIDGET(window.gobj()),
+      [](GtkWidget* /*widget*/, GdkFrameClock* frame_clock, gpointer data) {
+        auto* bar = static_cast<waybar::Bar*>(data);
+        const auto frame_time = gdk_frame_clock_get_frame_time(frame_clock);
+        if (bar->slide_started_at_ == 0) {
+          bar->slide_started_at_ = frame_time;
+        }
+
+        const auto elapsed = frame_time - bar->slide_started_at_;
+        const auto linear_progress = std::min(1.0, static_cast<double>(elapsed) / bar->slide_duration_);
+        const auto progress = 1.0 - std::pow(1.0 - linear_progress, bar->slide_ease_out_exponent_);
+        bar->slide_margin_ = static_cast<int>(bar->slide_start_ +
+                                              (bar->slide_target_ - bar->slide_start_) * progress);
+        gtk_layer_set_margin(bar->window.gobj(), GTK_LAYER_SHELL_EDGE_BOTTOM, bar->slide_margin_);
+        gtk_layer_try_force_commit(bar->window.gobj());
+        wl_display_flush(Client::inst()->wl_display);
+
+        if (linear_progress == 1.0) {
+          bar->slide_tick_callback_ = 0;
+          return G_SOURCE_REMOVE;
+        }
+        return G_SOURCE_CONTINUE;
+      },
+      this,
+      nullptr);
+}
+
 void waybar::Bar::toggle() { setVisible(!visible); }
 void waybar::Bar::show() { setVisible(true); }
 void waybar::Bar::hide() { setVisible(false); }
