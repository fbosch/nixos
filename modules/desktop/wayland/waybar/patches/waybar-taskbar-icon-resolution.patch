+std::vector<std::string> IconLoader::get_icon_candidates(const std::string& app_id,
+                                                         const std::string& title, bool use_title) {
+  std::vector<std::string> candidates;
+  if (use_title) {
+    for (const auto& candidate : title_candidates(title)) add_candidate(candidates, candidate);
+  }
+
+  std::istringstream app_ids(app_id);
+  for (std::string id; app_ids >> id;) {
+    add_value_candidates(candidates, id);
+    const auto final_dot = id.rfind('.');
+    if (final_dot != std::string::npos && id.find('/') == std::string::npos) {
+      add_value_candidates(candidates, id.substr(final_dot + 1));
+    }
+  }
+  return candidates;
+}
+
+bool IconLoader::should_use_title(const std::string& app_id, const std::string& title) {
+  return is_generic_wrapper(app_id) || app_id == "unknown" ||
+         lower_copy(title).ends_with(" (grabbed)");
+}
