+namespace {
+
+std::string trim_copy(const std::string& value) {
+  const auto first = value.find_first_not_of(" \t\n\r");
+  if (first == std::string::npos) return "";
+  return value.substr(first, value.find_last_not_of(" \t\n\r") - first + 1);
+}
+
+std::string lower_copy(std::string value) {
+  std::ranges::transform(value, value.begin(), [](unsigned char c) { return std::tolower(c); });
+  return value;
+}
+
+std::string normalize_identity(const std::string& value) {
+  std::string normalized;
+  for (const unsigned char c : lower_copy(value)) {
+    if (std::isalnum(c)) normalized += c;
+  }
+  return normalized;
+}
+
+void add_candidate(std::vector<std::string>& candidates, const std::string& candidate) {
+  const auto trimmed = trim_copy(candidate);
+  if (trimmed.empty() || std::ranges::find(candidates, trimmed) != candidates.end()) return;
+  candidates.push_back(trimmed);
+}
+
+void add_value_candidates(std::vector<std::string>& candidates, const std::string& value) {
+  const auto trimmed = trim_copy(value);
+  if (trimmed.empty()) return;
+
+  add_candidate(candidates, trimmed);
+  const auto lower = lower_copy(trimmed);
+  add_candidate(candidates, lower);
+  add_candidate(candidates, normalize_identity(trimmed));
+  auto separators = lower;
+  std::ranges::replace(separators, '_', '-');
+  std::ranges::replace(separators, ' ', '-');
+  add_candidate(candidates, separators);
+
+  std::string hyphenated;
+  for (size_t index = 0; index < trimmed.size(); index++) {
+    const auto character = static_cast<unsigned char>(trimmed[index]);
+    if (std::isupper(character) && index > 0 &&
+        std::islower(static_cast<unsigned char>(trimmed[index - 1]))) {
+      hyphenated += '-';
+    }
+    hyphenated += static_cast<char>(std::tolower(character));
+  }
+  add_candidate(candidates, hyphenated);
+  std::ranges::replace(hyphenated, '-', '_');
+  add_candidate(candidates, hyphenated);
+}
+
+std::string without_trailing_parentheticals(std::string value) {
+  while (!value.empty() && value.back() == ')') {
+    const auto start = value.rfind('(');
+    if (start == std::string::npos || start == 0 || value[start - 1] != ' ') break;
+    value = trim_copy(value.substr(0, start));
+  }
+  return value;
+}
+
+std::string without_trailing_version(const std::string& value) {
+  const auto separator = value.rfind(' ');
+  if (separator == std::string::npos) return value;
+
+  const auto version = value.substr(separator + 1);
+  if (version.find('.') == std::string::npos ||
+      !std::ranges::all_of(version, [](unsigned char c) { return std::isdigit(c) || c == '.'; })) {
+    return value;
+  }
+  return trim_copy(value.substr(0, separator));
+}
+
+std::vector<std::string> title_candidates(const std::string& title) {
+  auto value = trim_copy(title);
+  constexpr std::string_view grabbed = " (grabbed)";
+  if (value.size() >= grabbed.size() &&
+      lower_copy(value.substr(value.size() - grabbed.size())) == grabbed) {
+    value.resize(value.size() - grabbed.size());
+  }
+
+  std::vector<std::string> candidates;
+  add_value_candidates(candidates, value);
+  add_value_candidates(candidates, without_trailing_parentheticals(value));
+  add_value_candidates(candidates, without_trailing_version(value));
+  for (const auto delimiter : {" - ", ": "}) {
+    const auto position = value.find(delimiter);
+    if (position != std::string::npos) add_value_candidates(candidates, value.substr(0, position));
+  }
+  return candidates;
+}
+
+bool is_generic_wrapper(const std::string& app_id) {
+  static constexpr std::array<std::string_view, 8> wrappers = {
+      "gamescope", "steam", "wine", "lutris", "heroic", "bottles", "umu", "proton"};
+  const auto normalized = lower_copy(app_id);
+  return normalized.starts_with("steam_app_") ||
+         std::ranges::find(wrappers, normalized) != wrappers.end();
+}
+
+bool matches_candidate(const Glib::RefPtr<Gio::DesktopAppInfo>& app_info,
+                       const std::string& candidate) {
+  const auto normalized_candidate = normalize_identity(candidate);
+  if (normalized_candidate.empty()) return false;
+
+  const auto matches = [&normalized_candidate](const Glib::ustring& value) {
+    return normalize_identity(value) == normalized_candidate;
+  };
+  return matches(app_info->get_id()) || matches(app_info->get_startup_wm_class()) ||
+         matches(app_info->get_display_name()) || matches(app_info->get_executable());
+}
