+void AModule::runHoverCommand(const char* config_key) {
+  if (!config_[config_key].isString()) return;
+
+  auto sequence = g_get_monotonic_time();
+  if (sequence <= hover_sequence_) sequence = hover_sequence_ + 1;
+  hover_sequence_ = sequence;
+
+  auto command = config_[config_key].asString();
+  const std::string placeholder{"{sequence}"};
+  const auto replacement = std::to_string(sequence);
+  for (auto position = command.find(placeholder); position != std::string::npos;
+       position = command.find(placeholder, position + replacement.size())) {
+    command.replace(position, placeholder.size(), replacement);
+  }
+  pid_children_.push_back(util::command::forkExec(command));
+}
+
