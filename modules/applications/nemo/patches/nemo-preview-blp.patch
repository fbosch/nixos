+
+function BlpImageRenderer(args) {
+    this._init(args);
+}
+
+BlpImageRenderer.prototype = Object.create(ImageRenderer.prototype);
+
+BlpImageRenderer.prototype._createImageTexture = function(file) {
+    let inputPath = file.get_path();
+    let outputPath = GLib.build_filenamev([
+        GLib.get_tmp_dir(),
+        'nemo-preview-blp-' + GLib.uuid_string_random() + '.png'
+    ]);
+
+    let [success, stdout, stderr, status] = GLib.spawn_sync(
+        null,
+        ['@BLP_CONV@', inputPath, outputPath],
+        null,
+        GLib.SpawnFlags.SEARCH_PATH,
+        null);
+
+    if (!success || status !== 0) {
+        log('Unable to convert BLP file ' + inputPath);
+        GLib.unlink(outputPath);
+        this._callback();
+        return;
+    }
+
+    this._cleanupPath = outputPath;
+    let convertedFile = Gio.File.new_for_path(outputPath);
+    convertedFile.read_async
+        (GLib.PRIORITY_DEFAULT, null,
+         Lang.bind(this,
+                   function(obj, res) {
+                       try {
+                           let stream = obj.read_finish(res);
+                           this._textureFromStream(stream);
+                       } catch (e) {
+                           GLib.unlink(outputPath);
+                           this._cleanupPath = null;
+                           this._callback();
+                       }
+                   }));
+};
+
+let blpRenderer = new BlpImageRenderer();
+handler.registerMimeTypes(['image/x-blp'], blpRenderer);
