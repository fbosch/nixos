+function ConvertedImageRenderer(args) {
+    this._init(args);
+    this._converter = args.converter;
+    this._formatName = args.formatName;
+    this._outputSuffix = args.outputSuffix;
+}
+
+ConvertedImageRenderer.prototype = Object.create(ImageRenderer.prototype);
+
+ConvertedImageRenderer.prototype._createImageTexture = function(file) {
+    let inputPath = file.get_path();
+    let outputPath = GLib.build_filenamev([
+        GLib.get_tmp_dir(),
+        'nemo-preview-' + GLib.uuid_string_random() + this._outputSuffix
+    ]);
+
+    let [success, stdout, stderr, status] = GLib.spawn_sync(
+        null,
+        [this._converter, inputPath, outputPath],
+        null,
+        GLib.SpawnFlags.SEARCH_PATH,
+        null);
+
+    if (!success || status !== 0) {
+        log('Unable to convert ' + this._formatName + ' file ' + inputPath);
+        GLib.unlink(outputPath);
+        this._callback();
+        return;
+    }
+
+    this._cleanupPath = outputPath;
+    let convertedFile = Gio.File.new_for_path(outputPath);
+    convertedFile.read_async
+        (GLib.PRIORITY_DEFAULT, null,
+         Lang.bind(this,
+                   function(obj, res) {
+                       try {
+                           let stream = obj.read_finish(res);
+                           GLib.unlink(outputPath);
+                           this._cleanupPath = null;
+                           this._textureFromStream(stream);
+                       } catch (e) {
+                           GLib.unlink(outputPath);
+                           this._cleanupPath = null;
+                           this._callback();
+                       }
+                   }));
+};
+
+let blpRenderer = new ConvertedImageRenderer({
+    converter: '@BLP_CONV@',
+    formatName: 'BLP',
+    outputSuffix: '.png'
+});
+handler.registerMimeTypes(['image/x-blp'], blpRenderer);
+
+let rpgMakerRenderer = new ConvertedImageRenderer({
+    converter: '@RPG_MAKER_IMAGE_DECRYPTER@',
+    formatName: 'RPG Maker image',
+    outputSuffix: '.png'
+});
+handler.registerMimeTypes(['image/x-rpg-maker-encrypted'], rpgMakerRenderer);
