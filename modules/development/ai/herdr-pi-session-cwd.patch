+pub fn session_cwd_for_restore(session: &PersistedAgentSession) -> Option<PathBuf> {
+    if session.source != "herdr:pi"
+        || session.agent != "pi"
+        || session.session_ref.kind != AgentSessionRefKind::Path
+    {
+        return None;
+    }
+
+    let file = std::fs::File::open(&session.session_ref.value).ok()?;
+    let mut reader = BufReader::new(file).take(MAX_PI_SESSION_HEADER_BYTES + 1);
+    let mut header = String::new();
+    let bytes_read = reader.read_line(&mut header).ok()?;
+    if bytes_read == 0 || bytes_read as u64 > MAX_PI_SESSION_HEADER_BYTES {
+        return None;
+    }
+
+    let header: PiSessionHeader = serde_json::from_str(&header).ok()?;
+    (header.record_type == "session" && header.cwd.is_absolute() && header.cwd.is_dir())
+        .then_some(header.cwd)
+}
