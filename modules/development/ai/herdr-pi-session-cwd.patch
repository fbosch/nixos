+    #[test]
+    fn pi_restore_cwd_comes_from_valid_session_header() {
+        let root = unique_temp_dir("valid-cwd");
+        let cwd = root.join("repo");
+        let session_path = root.join("session.jsonl");
+        std::fs::create_dir(&cwd).unwrap();
+        std::fs::write(
+            &session_path,
+            format!(
+                "{{\"type\":\"session\",\"version\":3,\"cwd\":{}}}\n{{\"type\":\"message\"}}\n",
