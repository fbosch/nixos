+            ),
+        )
+        .unwrap();
+
+        assert_eq!(
+            session_cwd_for_restore(&persisted_pi_session(&session_path)),
+            Some(cwd)
+        );
+
+        std::fs::remove_dir_all(root).unwrap();
+    }
+
+    #[test]
+    fn pi_restore_cwd_rejects_invalid_session_headers() {
+        let root = unique_temp_dir("invalid-cwd");
+        let session_path = root.join("session.jsonl");
+        let cases = [
+            "not json\n".to_string(),
+            "{\"type\":\"message\",\"cwd\":\"/\"}\n".to_string(),
+            "{\"type\":\"session\",\"cwd\":\"relative\"}\n".to_string(),
+            format!(
+                "{{\"type\":\"session\",\"cwd\":{}}}\n",
+                serde_json::to_string(&root.join("missing")).unwrap()
+            ),
+            format!(
+                "{{\"type\":\"session\",\"cwd\":\"/\",\"padding\":\"{}\"}}\n",
+                "x".repeat(MAX_PI_SESSION_HEADER_BYTES as usize)
+            ),
+        ];
+
+        for contents in cases {
+            std::fs::write(&session_path, contents).unwrap();
+            assert_eq!(
+                session_cwd_for_restore(&persisted_pi_session(&session_path)),
+                None
+            );
+        }
+
+        std::fs::remove_dir_all(root).unwrap();
+    }
