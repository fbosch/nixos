{
  "version": 1,
  "profiles": {
    "ordinary": {
      "git-fsmonitor": {
        "access": "connect-existing",
        "platforms": [
          "darwin"
        ]
      },
      "neovim-ask": {}
    },
    "restricted": {
      "git-fsmonitor": {
        "access": "bind",
        "platforms": [
          "darwin",
          "linux"
        ]
      },
      "herdr-reporting": {},
      "neovim-ask": {},
      "desktop": {}
    }
  },
  "capabilities": {
    "git-fsmonitor": {
      "backend": "endpoint",
      "discovery": "selected-git-metadata",
      "filename": "fsmonitor--daemon.ipc",
      "authority": "full-protocol"
    },
    "herdr-reporting": {
      "backend": "json-lines",
      "limits": {
        "maxFrameBytes": 65536,
        "maxConnections": 16,
        "clientTimeoutMs": 2000,
        "upstreamTimeoutMs": 1500
      },
      "operations": {
        "ping": {
          "schema": {
            "type": "object",
            "properties": {},
            "additionalProperties": false
          },
          "bindings": {}
        },
        "pane.list": {
          "schema": {
            "type": "object",
            "properties": {
              "workspace_id": {
                "type": "string",
                "pattern": "^w[A-Za-z0-9_-]+$",
                "maxLength": 128
              }
            },
            "additionalProperties": false
          },
          "bindings": {
            "workspace_id": "workspace"
          }
        },
        "pane.read": {
          "schema": {
            "type": "object",
            "properties": {
              "pane_id": {
                "type": "string",
                "pattern": "^w[A-Za-z0-9_-]+:p[A-Za-z0-9_-]+$",
                "maxLength": 128
              },
              "source": {
                "enum": ["visible", "recent", "recent_unwrapped", "detection"]
              },
              "lines": {
                "type": "integer",
                "minimum": 1,
                "maximum": 200
              },
              "format": {
                "const": "text"
              },
              "strip_ansi": {
                "const": true
              }
            },
            "required": ["pane_id", "source"],
            "additionalProperties": false
          },
          "bindings": {}
        },
        "pane.report_agent": {
          "schema": {
            "type": "object",
            "properties": {
              "pane_id": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "agent": {
                "type": "string"
              },
              "seq": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "state": {
                "enum": [
                  "idle",
                  "working",
                  "blocked"
                ]
              },
              "message": {
                "type": "string",
                "format": "ipc-text",
                "maxUtf8Bytes": 1024
              },
              "agent_session_id": {
                "type": "string",
                "format": "ipc-text",
                "maxUtf8Bytes": 36,
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
              },
              "agent_session_path": {
                "type": "string",
                "format": "ipc-text",
                "maxUtf8Bytes": 4096
              }
            },
            "required": [
              "pane_id",
              "source",
              "agent",
              "state"
            ],
            "additionalProperties": false,
            "not": {
              "required": [
                "agent_session_id",
                "agent_session_path"
              ]
            }
          },
          "bindings": {
            "pane_id": "pane",
            "source": "source",
            "agent": "agent"
          }
        },
        "pane.report_agent_session": {
          "schema": {
            "type": "object",
            "properties": {
              "pane_id": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "agent": {
                "type": "string"
              },
              "seq": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "agent_session_id": {
                "type": "string",
                "format": "ipc-text",
                "maxUtf8Bytes": 36,
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
              },
              "agent_session_path": {
                "type": "string",
                "format": "ipc-text",
                "maxUtf8Bytes": 4096
              },
              "session_start_source": {
                "enum": [
                  "startup",
                  "reload",
                  "new",
                  "resume",
                  "fork"
                ]
              }
            },
            "required": [
              "pane_id",
              "source",
              "agent"
            ],
            "additionalProperties": false,
            "not": {
              "required": [
                "agent_session_id",
                "agent_session_path"
              ]
            },
            "anyOf": [
              {
                "required": [
                  "agent_session_id"
                ]
              },
              {
                "required": [
                  "agent_session_path"
                ]
              }
            ]
          },
          "bindings": {
            "pane_id": "pane",
            "source": "source",
            "agent": "agent"
          }
        },
        "pane.report_metadata": {
          "schema": {
            "type": "object",
            "properties": {
              "pane_id": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "agent": {
                "type": "string"
              },
              "seq": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "applies_to_source": {
                "type": "string"
              },
              "tokens": {
                "type": "object",
                "properties": {
                  "pi_session_title": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "ipc-text",
                        "maxUtf8Bytes": 1024
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "pi_session_title"
                ],
                "additionalProperties": false
              },
              "display_agent": {
                "const": "Pi"
              },
              "clear_display_agent": {
                "const": true
              }
            },
            "required": [
              "pane_id",
              "source",
              "agent",
              "applies_to_source",
              "tokens"
            ],
            "additionalProperties": false,
            "not": {
              "required": [
                "display_agent",
                "clear_display_agent"
              ]
            }
          },
          "bindings": {
            "pane_id": "pane",
            "source": "titleSource",
            "agent": "agent",
            "applies_to_source": "source",
            "display_agent": "displayAgent",
            "clear_display_agent": "clearDisplayAgent"
          }
        },
        "pane.release_agent": {
          "schema": {
            "type": "object",
            "properties": {
              "pane_id": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "agent": {
                "type": "string"
              },
              "seq": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "pane_id",
              "source",
              "agent"
            ],
            "additionalProperties": false
          },
          "bindings": {
            "pane_id": "pane",
            "source": "source",
            "agent": "agent"
          }
        }
      },
      "cleanup": [
        {
          "id": "pi-host:release",
          "method": "pane.release_agent",
          "params": {}
        },
        {
          "id": "pi-host:title-clear",
          "method": "pane.report_metadata",
          "params": {
            "tokens": {
              "pi_session_title": null
            }
          },
          "optionalBindings": [
            "clear_display_agent"
          ]
        }
      ],
      "provider": "herdr",
      "socketEnvironment": "HERDR_SOCKET_PATH"
    },
    "desktop": {
      "backend": "json-lines",
      "limits": {
        "maxFrameBytes": 65536,
        "maxConnections": 4,
        "clientTimeoutMs": 10000,
        "upstreamTimeoutMs": 8000
      },
      "operations": {
        "clipboard.copy_text": {
          "schema": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "maxUtf8Bytes": 61440
              }
            },
            "required": [
              "text"
            ],
            "additionalProperties": false
          },
          "bindings": {}
        },
        "image.open": {
          "schema": {
            "type": "object",
            "properties": {
              "imageId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
              "offset": { "type": "integer", "minimum": 0, "maximum": 33554432 },
              "totalBytes": { "type": "integer", "minimum": 1, "maximum": 33554432 },
              "data": { "type": "string", "minLength": 4, "maxLength": 43692, "pattern": "^[A-Za-z0-9+/]+={0,2}$" }
            },
            "required": ["imageId", "offset", "totalBytes", "data"],
            "additionalProperties": false
          },
          "bindings": {}
        },
        "screenshot.capture": {
          "schema": {
            "type": "object",
            "properties": {
              "output": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]{1,64}$"
              },
              "region": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "integer",
                    "minimum": -65536,
                    "maximum": 65536
                  },
                  "y": {
                    "type": "integer",
                    "minimum": -65536,
                    "maximum": 65536
                  },
                  "width": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 32768
                  },
                  "height": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 32768
                  }
                },
                "required": [
                  "x",
                  "y",
                  "width",
                  "height"
                ],
                "additionalProperties": false
              }
            },
            "additionalProperties": false,
            "not": {
              "required": [
                "output",
                "region"
              ]
            }
          },
          "bindings": {}
        }
      },
      "cleanup": [],
      "provider": "desktop",
      "socketEnvironment": "PI_DESKTOP_SOCKET"
    },
    "neovim-ask": {
      "backend": "json-lines",
      "limits": {
        "maxFrameBytes": 67584,
        "maxConnections": 4,
        "clientTimeoutMs": 5000,
        "upstreamTimeoutMs": 5000
      },
      "persistent": true,
      "operations": {
        "neovim.bind": {
          "schema": {
            "type": "object",
            "properties": {
              "launchId": { "type": "string", "format": "ipc-text", "maxUtf8Bytes": 32, "pattern": "^[a-f0-9]{32}$" },
              "cwd": { "type": "string", "format": "ipc-text", "maxUtf8Bytes": 4096 },
              "sessionId": { "type": "string", "format": "ipc-text", "maxUtf8Bytes": 1024, "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$" }
            },
            "required": ["launchId", "cwd", "sessionId"],
            "additionalProperties": false
          },
          "bindings": { "launchId": "launchId", "cwd": "cwd" }
        },
        "neovim.ack": {
          "schema": {
            "type": "object",
            "properties": {
              "payload": {
                "type": "object",
                "properties": {
                  "version": { "const": 1 },
                  "requestId": { "type": "string", "format": "ipc-text", "maxUtf8Bytes": 128 },
                  "launchId": { "type": "string", "format": "ipc-text", "maxUtf8Bytes": 32, "pattern": "^[a-f0-9]{32}$" },
                  "sessionId": { "type": "string", "format": "ipc-text", "maxUtf8Bytes": 1024, "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$" },
                  "ownerId": { "type": "string", "format": "ipc-text", "maxUtf8Bytes": 128 },
                  "outcome": { "enum": ["accepted", "duplicate", "rejected"] },
                  "state": { "enum": ["starting", "idle", "streaming", "blocked", "closed"] },
                  "code": {
                    "enum": [
                      "PI_BUSY", "PI_DISCONNECTED", "PI_DELIVERY_UNKNOWN", "PI_INVALID_REQUEST",
                      "PI_INVALID_UTF8", "PI_LAUNCH_MISMATCH", "PI_NO_UI", "PI_PROMPT_EMPTY",
                      "PI_PROMPT_TOO_LARGE", "PI_REQUEST_ID_REUSED", "PI_REQUEST_OUT_OF_ORDER",
                      "PI_REQUEST_PENDING", "PI_SESSION_MISMATCH", "PI_SESSION_NOT_READY",
                      "PI_STALE_REQUEST", "PI_UNSUPPORTED", "PI_WORKTREE_MISMATCH"
                    ]
                  }
                },
                "required": ["version", "requestId", "launchId", "sessionId", "ownerId", "outcome", "state"],
                "additionalProperties": false
              }
            },
            "required": ["payload"],
            "additionalProperties": false
          },
          "bindings": {}
        },
        "neovim.close": {
          "schema": { "type": "object", "properties": {}, "additionalProperties": false },
          "bindings": {}
        }
      },
      "notifications": {
        "neovim.prompt": {
          "type": "object",
          "properties": {
            "version": { "const": 1 },
            "requestId": { "type": "string", "maxUtf8Bytes": 128 },
            "sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
            "operation": { "enum": ["append", "submit"] },
            "launchId": { "type": "string", "maxUtf8Bytes": 32, "pattern": "^[a-f0-9]{32}$" },
            "sessionId": { "type": "string", "maxUtf8Bytes": 1024, "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$" },
            "ownerId": { "type": "string", "maxUtf8Bytes": 128 },
            "cwd": { "type": "string", "maxUtf8Bytes": 4096 },
            "editorPid": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
            "text": { "type": "string", "maxUtf8Bytes": 16384 },
            "context": {}
          },
          "required": ["version", "requestId", "sequence", "operation", "launchId", "sessionId", "ownerId", "cwd", "editorPid", "text", "context"],
          "additionalProperties": false
        }
      },
      "cleanup": [],
      "provider": "neovim",
      "socketEnvironment": "PI_NVIM_ASK_SOCKET"
    }
  }
}
