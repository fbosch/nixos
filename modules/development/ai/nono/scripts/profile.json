{
    "extends": "default",
    "filesystem": {
        "allow": [
            "$HOME/.pi",
            "$HOME/.npm/_cacache",
            "$HOME/.npm/_logs"
        ],
        "read": [
            "$HOME/.agents/skills",
            "$HOME/.nvm",
            "/tmp",
            "$TMPDIR"
        ],
        "suppress_save_prompt": [
            "/"
        ]
    },
    "groups": {
        "include": [
            "node_runtime",
            "rust_runtime",
            "python_runtime",
            {
                "name": "user_caches_macos",
                "when": "macos"
            },
            {
                "name": "user_caches_linux",
                "when": "linux"
            },
            {
                "name": "linux_sysfs_read",
                "when": "linux"
            },
            "nix_runtime",
            "git_config",
            "unlink_protection"
        ]
    },
    "meta": {
        "description": "Pi with project reference grants and macOS LMDB semaphore support",
        "name": "pi-local"
    },
    "network": {
        "block": false
    },
    "security": {
        "capability_elevation": false,
        "signal_mode": "isolated"
    },
    "unsafe_macos_seatbelt_rules": [
        "(allow ipc-sysv-sem)"
    ],
    "workdir": {
        "access": "readwrite"
    }
}
