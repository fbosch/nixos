{
    "extends": "default",
    "filesystem": {
        "allow": [
            "$HOME/.pi",
            "$HOME/.npm/_cacache",
            "$HOME/.npm/_logs",
            "$HOME/.azure",
            "$HOME/.azure-devops/python-sdk/cache",
            {
                "path": "/dev/dri",
                "when": "linux"
            }
        ],
        "read": [
            "$HOME/.agents/skills",
            "$HOME/.local/share/gh/extensions",
            "$HOME/.nvm",
            "/tmp",
            "$TMPDIR"
        ],
        "bypass_protection": [
            "$HOME/.azure"
        ],
        "unix_socket": [
            {
                "path": "/nix/var/nix/daemon-socket/socket",
                "when": "linux"
            }
        ],
        "suppress_save_prompt": [
            "/"
        ]
    },
    "groups": {
        "include": [
            "node_runtime",
            "rust_runtime",
            "python_runtime",
            {
                "name": "user_caches_macos",
                "when": "macos"
            },
            {
                "name": "user_caches_linux",
                "when": "linux"
            },
            {
                "name": "linux_sysfs_read",
                "when": "linux"
            },
            "nix_runtime",
            "git_config",
            "unlink_protection"
        ]
    },
    "linux": {
        "af_unix_mediation": "off",
        "sandbox_policy": "landlock"
    },
    "meta": {
        "description": "Pi with project reference grants and macOS LMDB semaphore support",
        "name": "pi-local"
    },
    "network": {
        "block": false,
        "open_port": [9222, 2828],
        "credentials": ["github"],
        "custom_credentials": {
            "github": {
                "upstream": "https://api.github.com",
                "credential_key": "cmd://github",
                "env_var": "GH_TOKEN"
            }
        }
    },
    "credential_capture": {
        "github": {
            "command": ["@GH_CAPTURE_BIN@", "auth", "token", "--hostname", "github.com"],
            "timeout_secs": 10,
            "cache_ttl_secs": 300
        }
    },
    "security": {
        "capability_elevation": false,
        "signal_mode": "isolated"
    },
    "unsafe_macos_seatbelt_rules": [
        "(allow network-outbound (remote tcp \"*:22\"))",
        "(allow network-outbound (remote tcp \"localhost:*\"))",
        "(allow ipc-sysv-sem)",
        "(allow lsopen)",
        "(allow iokit-open (iokit-user-client-class \"RootDomainUserClient\"))",
        "(allow mach-register (global-name-regex #\"^(org[.]chromium[.]Chromium|com[.]google[.]Chrome|com[.]google[.]chrome[.]for[.]testing)[.]MachPortRendezvousServer[.][0-9]+$\"))"
    ],
    "workdir": {
        "access": "readwrite"
    }
}
