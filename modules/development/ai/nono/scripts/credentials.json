{
  "github": {
    "label": "GitHub",
    "route": {
      "upstream": "https://api.github.com",
      "env_var": "GH_TOKEN"
    },
    "source": {
      "type": "command",
      "package": "gh",
      "program": "gh",
      "args": [
        "auth",
        "token",
        "--hostname",
        "github.com"
      ],
      "protected_directories": [
        "$HOME/.config/gh"
      ],
      "protected_files": [
        "$HOME/.config/gh/hosts.yml"
      ]
    },
    "aliases": [
      "GITHUB_TOKEN",
      "GITHUB_PERSONAL_ACCESS_TOKEN",
      "GH_ENTERPRISE_TOKEN",
      "GITHUB_ENTERPRISE_TOKEN"
    ],
    "environment": {
      "unset": [
        "GH_DEBUG",
        "DEBUG",
        "GH_HOST",
        "GITHUB_HOST"
      ],
      "set": {
        "GH_CONFIG_DIR": "$HOME/.config/gh"
      }
    },
    "capture": {
      "timeout_secs": 10,
      "cache_ttl_secs": 300
    }
  },
  "context7": {
    "label": "Context7",
    "route": {
      "upstream": "https://mcp.context7.com",
      "env_var": "CONTEXT7_API_KEY",
      "inject_header": "Authorization",
      "credential_format": "Bearer {}"
    },
    "source": {
      "type": "file",
      "path": "/run/secrets/context7-api-key",
      "sops": {
        "file": "apis",
        "key": "context7-api-key"
      }
    },
    "capture": {
      "timeout_secs": 10,
      "cache_ttl_secs": 300
    }
  }
}
