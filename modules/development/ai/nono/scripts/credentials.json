{
  "github": {
    "label": "GitHub",
    "route": {
      "upstream": "https://api.github.com",
      "env_var": "GH_TOKEN"
    },
    "source": {
      "type": "command",
      "package": "gh",
      "program": "gh",
      "args": [
        "auth",
        "token",
        "--hostname",
        "github.com"
      ],
      "protected_directories": [
        "$HOME/.config/gh"
      ],
      "protected_files": [
        "$HOME/.config/gh/hosts.yml"
      ]
    },
    "aliases": [
      "GITHUB_TOKEN",
      "GITHUB_PERSONAL_ACCESS_TOKEN",
      "GH_ENTERPRISE_TOKEN",
      "GITHUB_ENTERPRISE_TOKEN"
    ],
    "environment": {
      "unset": [
        "GH_DEBUG",
        "DEBUG",
        "GH_HOST",
        "GITHUB_HOST"
      ],
      "set": {
        "GH_CONFIG_DIR": "$HOME/.config/gh"
      }
    },
    "capture": {
      "timeout_secs": 10,
      "cache_ttl_secs": 300
    }
  },
  "anthropic": {
    "label": "Claude CLI",
    "route": {
      "upstream": "https://api.anthropic.com",
      "env_var": "CLAUDE_CODE_OAUTH_TOKEN",
      "inject_header": "Authorization",
      "credential_format": "Bearer {}"
    },
    "source": {
      "type": "command",
      "package": "nodejs",
      "program": "node",
      "script": "claude-credential.mjs",
      "args": [],
      "protected_files": ["$HOME/.claude/.credentials.json"]
    },
    "aliases": ["ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN"],
    "environment": {
      "unset": ["ANTHROPIC_BASE_URL", "CLAUDE_CONFIG_DIR"]
    },
    "capture": {
      "timeout_secs": 5,
      "cache_ttl_secs": 30
    }
  },
  "context7": {
    "label": "Context7",
    "route": {
      "upstream": "https://mcp.context7.com",
      "env_var": "CONTEXT7_API_KEY",
      "inject_header": "Authorization",
      "credential_format": "Bearer {}"
    },
    "source": {
      "type": "file",
      "path": "/run/secrets/context7-api-key",
      "sops": {
        "file": "apis",
        "key": "context7-api-key"
      }
    },
    "capture": {
      "timeout_secs": 10,
      "cache_ttl_secs": 300
    }
  },
  "exa": {
    "label": "Exa",
    "route": {
      "upstream": "https://api.exa.ai",
      "env_var": "EXA_API_KEY",
      "inject_header": "x-api-key",
      "credential_format": "{}"
    },
    "source": {
      "type": "file",
      "path": "/run/secrets/exa-api-key",
      "sops": {
        "file": "apis",
        "key": "exa-api-key"
      }
    },
    "capture": {
      "timeout_secs": 10,
      "cache_ttl_secs": 300
    }
  },
  "exa_mcp": {
    "label": "Exa MCP",
    "route": {
      "upstream": "https://mcp.exa.ai",
      "env_var": "EXA_API_KEY",
      "inject_header": "x-api-key",
      "credential_format": "{}"
    },
    "source": {
      "type": "file",
      "path": "/run/secrets/exa-api-key",
      "sops": {
        "file": "apis",
        "key": "exa-api-key"
      }
    },
    "capture": {
      "timeout_secs": 10,
      "cache_ttl_secs": 300
    }
  }
}
