@@ -0,0 +1,46 @@
+import { ExtensionRunner } from "./runner.ts";
+import type { SessionManager } from "../session-manager.ts";
+import { ModelRegistry } from "../model-registry.ts";
+import type { ModelRuntime } from "../model-runtime.ts";
+import type { ResourceLoader } from "../resource-loader.ts";
+import type { SettingsManager } from "../settings-manager.ts";
+import type { BeforeModelAvailabilityEvent, SessionStartEvent } from "./types.ts";
+
+// Pre-session context: no model, command actions, or UI yet. Do not bindCore here:
+// its action bindings belong to the eventual AgentSession, not this short-lived runner.
+export async function prepareModelAvailability(options: {
+	cwd: string;
+	sessionManager: SessionManager;
+	settingsManager: SettingsManager;
+	resourceLoader: ResourceLoader;
+	modelRuntime: ModelRuntime;
+	sessionStartEvent?: SessionStartEvent;
+}): Promise<void> {
+	const { extensions, runtime } = options.resourceLoader.getExtensions();
+	const runner = new ExtensionRunner(
+		extensions,
+		runtime,
+		options.cwd,
+		options.sessionManager,
+		new ModelRegistry(options.modelRuntime),
+		() => options.settingsManager.isProjectTrusted(),
+	);
+	const start = options.sessionStartEvent ?? { reason: "startup" as const };
+	await emitBeforeModelAvailability(runner, { ...start, type: "before_model_availability" });
+	// The hook binds credentials without refreshing; selection reads a snapshot.
+	await options.modelRuntime.refresh({ allowNetwork: false });
+}
+
+export async function emitBeforeModelAvailability(
+	runner: ExtensionRunner,
+	event: BeforeModelAvailabilityEvent,
+): Promise<void> {
+	const errors: Error[] = [];
+	const unsubscribe = runner.onError((error) => errors.push(new Error(error.error)));
+	try {
+		await runner.emit(event);
+		if (errors.length > 0) throw new AggregateError(errors, "Could not prepare model availability");
+	} finally {
+		unsubscribe();
+	}
+}
