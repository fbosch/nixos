+import { ModelRegistry } from "../model-registry.js";
+import { ExtensionRunner } from "./runner.js";
+
+// Pre-session context: no model, command actions, or UI yet. Do not bindCore here:
+// its action bindings belong to the eventual AgentSession, not this short-lived runner.
+export async function prepareModelAvailability({ cwd, sessionManager, settingsManager, resourceLoader, modelRuntime, sessionStartEvent }) {
+    const { extensions, runtime } = resourceLoader.getExtensions();
+    const runner = new ExtensionRunner(extensions, runtime, cwd, sessionManager, new ModelRegistry(modelRuntime));
+    runner.isProjectTrustedFn = () => settingsManager.isProjectTrusted();
+    const start = sessionStartEvent ?? { reason: "startup" };
+    await emitBeforeModelAvailability(runner, { ...start, type: "before_model_availability" });
+    // The hook binds credentials without refreshing; selection reads a snapshot.
+    await modelRuntime.refresh({ allowNetwork: false });
+}
+
+export async function emitBeforeModelAvailability(runner, event) {
+    const errors = [];
+    const unsubscribe = runner.onError((error) => errors.push(new Error(error.error)));
+    try {
+        await runner.emit(event);
+        if (errors.length > 0) {
+            throw new AggregateError(errors, "Could not prepare model availability");
+        }
+    }
+    finally {
+        unsubscribe();
+    }
+}
