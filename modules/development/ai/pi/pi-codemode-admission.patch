+import { availableParallelism, cpus, totalmem } from "node:os";
+
+export const CODEMODE_MEMORY_LIMIT_BYTES = 256 * 1024 * 1024;
+// Reserve the entire sandbox allowance plus host overhead, not the RSS of an idle fixture.
+export const CODEMODE_WORKER_BUDGET_BYTES = CODEMODE_MEMORY_LIMIT_BYTES + 64 * 1024 * 1024;
+const RESOURCE_RECHECK_MS = 100;
+const CPU_PRESSURE_THRESHOLD = 0.85;
+
+export interface CodemodeWorkerResources {
+	availableMemory: number;
+	totalMemory: number;
+	parallelism: number;
+	cpuUtilization: number;
+}
+
+export interface CodemodeAdmissionDetails {
+	sessionId: string;
+	toolCallId: string;
+	queuedAt: number;
+	admittedAt?: number;
+	startedAt?: number;
+	releasedAt?: number;
+	waitMs: number;
+	resourceLimit?: number;
+	activeWorkers?: number;
+}
+
+export interface CodemodeWorkerEvent extends CodemodeAdmissionDetails {
+	kind: "queued" | "admitted" | "started" | "released" | "aborted" | "timeout";
+}
+
+export interface CodemodeWorkerLease {
+	snapshot(): CodemodeAdmissionDetails;
+	started(): void;
+	// Call on actual worker exit, or when a reserved script never starts a worker.
+	release(): void;
+}
+
+export class CodemodeAdmissionError extends Error {
+	readonly reason: "aborted" | "timeout";
+	readonly details: CodemodeAdmissionDetails;
+
+	constructor(reason: "aborted" | "timeout", details: CodemodeAdmissionDetails) {
+		super(`Codemode worker admission ${reason}`);
+		this.name = "CodemodeAdmissionError";
+		this.reason = reason;
+		this.details = details;
+	}
+}
+
+interface Request {
+	sessionId: string;
+	toolCallId: string;
+	signal?: AbortSignal;
+	timeoutMs: number;
+	onEvent?: (event: CodemodeWorkerEvent) => void;
+}
+
+interface Waiter {
+	request: Request;
+	details: CodemodeAdmissionDetails;
+	queuedAt: number;
+	bypassed: boolean;
+	settled: boolean;
+	cleanup(): void;
+	resolve(lease: CodemodeWorkerLease): void;
+	reject(error: Error): void;
+}
+
+export function createCodemodeResourceProbe(): () => CodemodeWorkerResources {
+	let previous: { at: number; idle: number; total: number } | undefined;
+	let utilization = 0;
+	return () => {
+		const now = performance.now();
+		if (!previous || now - previous.at >= RESOURCE_RECHECK_MS) {
+			const times = cpus().reduce(
+				(sum, cpu) => ({
+					idle: sum.idle + cpu.times.idle,
+					total: sum.total + Object.values(cpu.times).reduce((a, b) => a + b, 0),
+				}),
+				{ idle: 0, total: 0 },
+			);
+			if (previous && times.total > previous.total) {
+				const sample = Math.max(0, Math.min(1, 1 - (times.idle - previous.idle) / (times.total - previous.total)));
+				utilization = 0.5 * utilization + 0.5 * sample;
+			}
+			previous = { at: now, ...times };
+		}
+		const constrained = process.constrainedMemory();
+		return {
+			availableMemory: process.availableMemory(),
+			totalMemory: constrained > 0 ? Math.min(totalmem(), constrained) : totalmem(),
+			parallelism: availableParallelism(),
+			cpuUtilization: utilization,
+		};
+	};
+}
+
+function configuredCeiling(): number | undefined {
+	const value = process.env.PI_CODEMODE_MAX_WORKERS;
+	if (value === undefined) return undefined;
+	const parsed = Number(value);
+	if (!Number.isSafeInteger(parsed) || parsed < 1) {
+		throw new Error("PI_CODEMODE_MAX_WORKERS must be a positive safe integer");
+	}
+	return parsed;
+}
+
+export class CodemodeWorkerAdmission {
+	private readonly resources: () => CodemodeWorkerResources;
+	private readonly ceiling: () => number | undefined;
+	private readonly now: () => number;
+	private readonly retryMs: number;
+	private readonly holders = new Map<symbol, string>();
+	private readonly waiters: Waiter[] = [];
+	private retry: ReturnType<typeof setTimeout> | undefined;
+	private pumping = false;
+	private windowAt = Number.NEGATIVE_INFINITY;
+	private startsInWindow = 0;
+	private resourceLimit = 0;
+
+	constructor(
+		options: {
+			resources?: () => CodemodeWorkerResources;
+			ceiling?: () => number | undefined;
+			now?: () => number;
+			retryMs?: number;
+		} = {},
+	) {
+		this.resources = options.resources ?? createCodemodeResourceProbe();
+		this.ceiling = options.ceiling ?? configuredCeiling;
+		this.now = options.now ?? (() => performance.now());
+		this.retryMs = options.retryMs ?? RESOURCE_RECHECK_MS;
+		if (!Number.isFinite(this.retryMs) || this.retryMs <= 0) throw new Error("retryMs must be positive");
+	}
+
+	snapshot(): { activeWorkers: number; queuedRequests: number; resourceLimit: number } {
+		return {
+			activeWorkers: this.holders.size,
+			queuedRequests: this.waiters.length,
+			resourceLimit: this.resourceLimit,
+		};
+	}
+
+	acquire(request: Request): Promise<CodemodeWorkerLease> {
+		if (!Number.isFinite(request.timeoutMs) || request.timeoutMs < 0)
+			throw new Error("timeoutMs must be non-negative");
+		return new Promise((resolve, reject) => {
+			const waiter: Waiter = {
+				request,
+				details: { sessionId: request.sessionId, toolCallId: request.toolCallId, queuedAt: Date.now(), waitMs: 0 },
+				queuedAt: this.now(),
+				bypassed: false,
+				settled: false,
+				cleanup: () => {},
+				resolve,
+				reject,
+			};
+			const onAbort = () => this.fail(waiter, "aborted");
+			const timer = setTimeout(() => this.fail(waiter, "timeout"), request.timeoutMs);
+			waiter.cleanup = () => {
+				clearTimeout(timer);
+				request.signal?.removeEventListener("abort", onAbort);
+			};
+			this.waiters.push(waiter);
+			request.signal?.addEventListener("abort", onAbort, { once: true });
+			this.emit(waiter, "queued");
+			if (request.signal?.aborted) this.fail(waiter, "aborted");
+			else if (request.timeoutMs === 0) this.fail(waiter, "timeout");
+			else this.pump();
+		});
+	}
+
+	private emit(waiter: Waiter, kind: CodemodeWorkerEvent["kind"]): void {
+		try {
+			waiter.request.onEvent?.({ ...waiter.details, kind });
+		} catch (error) {
+			// Observability must not leak a slot or throw from a worker's exit event.
+			process.emitWarning(error instanceof Error ? error : String(error), { type: "CodemodeWorkerTelemetry" });
+		}
+	}
+
+	private fail(waiter: Waiter, reason: "aborted" | "timeout"): void {
+		if (waiter.settled) return;
+		waiter.settled = true;
+		waiter.cleanup();
+		const index = this.waiters.indexOf(waiter);
+		if (index >= 0) this.waiters.splice(index, 1);
+		waiter.details.waitMs = this.now() - waiter.queuedAt;
+		this.emit(waiter, reason);
+		waiter.reject(new CodemodeAdmissionError(reason, { ...waiter.details }));
+		this.pump();
+	}
+
+	private grant(waiter: Waiter): void {
+		waiter.settled = true;
+		waiter.cleanup();
+		const token = Symbol();
+		this.holders.set(token, waiter.request.sessionId);
+		Object.assign(waiter.details, {
+			admittedAt: Date.now(),
+			waitMs: this.now() - waiter.queuedAt,
+			resourceLimit: this.resourceLimit,
+			activeWorkers: this.holders.size,
+		});
+		this.startsInWindow++;
+		this.emit(waiter, "admitted");
+		waiter.resolve({
+			snapshot: () => ({ ...waiter.details }),
+			started: () => {
+				if (!this.holders.has(token)) throw new Error("Codemode worker reservation already released");
+				waiter.details.startedAt = Date.now();
+				this.emit(waiter, "started");
+			},
+			release: () => {
+				if (!this.holders.delete(token)) return;
+				waiter.details.releasedAt = Date.now();
+				this.emit(waiter, "released");
+				this.pump();
+			},
+		});
+	}
+
+	private pump(): void {
+		if (this.pumping) return;
+		this.pumping = true;
+		clearTimeout(this.retry);
+		this.retry = undefined;
+		let ceiling: number | undefined;
+		try {
+			if (!this.waiters.length) return;
+			const resources = this.resources();
+			ceiling = this.ceiling();
+			if (
+				!Number.isFinite(resources.availableMemory) ||
+				resources.availableMemory < 0 ||
+				!Number.isFinite(resources.totalMemory) ||
+				resources.totalMemory <= 0 ||
+				!Number.isSafeInteger(resources.parallelism) ||
+				resources.parallelism < 1 ||
+				!Number.isFinite(resources.cpuUtilization) ||
+				resources.cpuUtilization < 0 ||
+				resources.cpuUtilization > 1 ||
+				(ceiling !== undefined && (!Number.isSafeInteger(ceiling) || ceiling < 1))
+			) {
+				throw new Error("Invalid codemode worker resource or ceiling probe");
+			}
+			const reserve = Math.min(resources.totalMemory / 8, 1024 * 1024 * 1024);
+			// Counting full budgets for holders is deliberately conservative: their heaps may still grow.
+			const memoryLimit = Math.floor(
+				Math.max(0, resources.availableMemory - reserve) / CODEMODE_WORKER_BUDGET_BYTES,
+			);
+			this.resourceLimit = Math.min(memoryLimit, ceiling ?? memoryLimit);
+			const now = this.now();
+			if (now - this.windowAt >= this.retryMs) {
+				this.windowAt = now;
+				this.startsInWindow = 0;
+			}
+			const starts = Math.max(1, Math.floor(resources.parallelism * (1 - resources.cpuUtilization)));
