+    if (indexed.has(key)) continue;
+    const result = {
+      role: "toolResult",
+      toolCallId: call.id,
+      toolName: call.name,
+      content: [
+        {
+          type: "text",
+          text: "Tool outcome unknown after interruption. Do not execute this call again; inspect the affected state before deciding what to do next.",
+        },
+      ],
+      isError: true,
+      timestamp,
+      openAI: { ...meta, nonRetryable: true },
+    };
