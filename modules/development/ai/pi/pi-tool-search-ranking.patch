+		throw new Error("Tool search ranker was unregistered or replaced during ranking");
+	if (!result || !Array.isArray(result.matches)) throw new Error("Tool search ranker must return a matches array");
+	if (result.matches.length > limit)
+		throw new Error("Tool search ranker returned more matches than the requested limit");
+	const candidateNames = new Set(documents.map((document) => document.name));
+	const seen = new Set<string>();
+	for (const match of result.matches) {
+		if (!match || typeof match.name !== "string" || !candidateNames.has(match.name))
+			throw new Error("Tool search ranker returned an unknown candidate");
+		if (seen.has(match.name))
+			throw new Error(`Tool search ranker returned duplicate candidate ${JSON.stringify(match.name)}`);
+		if (typeof match.score !== "number" || !Number.isFinite(match.score) || match.score < 0)
+			throw new Error(`Tool search ranker returned an invalid score for ${JSON.stringify(match.name)}`);
+		seen.add(match.name);
+	}
