+
+const toolSearchRankers = new WeakMap<object, { ranker: ToolSearchRankingHook }>();
+
+/** Install a ranking hook for one session's model registry; stale unregister callbacks cannot remove replacements. */
+export function installToolSearchRanker(registry: object, ranker: ToolSearchRankingHook): () => void {
+	if ((typeof registry !== "object" && typeof registry !== "function") || registry === null) {
+		throw new TypeError("registry must be an object");
+	}
+	if (typeof ranker !== "function") throw new TypeError("ranker must be a function");
+	const installation = { ranker };
+	toolSearchRankers.set(registry, installation);
+	let active = true;
+	return () => {
+		if (!active) return;
+		active = false;
+		if (toolSearchRankers.get(registry) === installation) toolSearchRankers.delete(registry);
+	};
+}
+
+function checkSearchSignal(signal: AbortSignal | undefined): void {
+	if (!signal?.aborted) return;
+	if (typeof signal.throwIfAborted === "function") signal.throwIfAborted();
+	const error = new Error("Tool search ranking aborted");
+	error.name = "AbortError";
+	throw error;
+}
+
+function combineSearchSignals(signal?: AbortSignal, contextSignal?: AbortSignal): AbortSignal | undefined {
+	if (!signal) return contextSignal;
+	if (!contextSignal || signal === contextSignal) return signal;
+	return AbortSignal.any([signal, contextSignal]);
+}
+
+function validateSearchLimit(limit: number): void {
+	if (!Number.isInteger(limit) || limit <= 0) throw new Error("Tool search limit must be a positive integer");
