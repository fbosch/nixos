+import type { AssistantMessage, ToolResultMessage } from "@earendil-works/pi-ai";
+import type { AgentContext, AgentEvent, AgentLoopConfig, AgentMessage, AgentTool, AgentToolCall, AgentToolResult } from "./types.ts";
+
+type Emit = (event: AgentEvent) => Promise<void> | void;
+type Outcome = { result: AgentToolResult<unknown>; isError: boolean };
+type Prepared = { kind: "prepared"; toolCall: AgentToolCall; tool: AgentTool; args: unknown };
+type Finalized = Outcome & { toolCall: AgentToolCall };
+interface NativeToolHelpers {
+    prepareToolCall(context: AgentContext, assistant: AssistantMessage, call: AgentToolCall, config: AgentLoopConfig, signal?: AbortSignal): Promise<Prepared | (Outcome & { kind: "immediate" })>;
+    executePreparedToolCall(prepared: Prepared, signal: AbortSignal | undefined, emit: Emit): Promise<Outcome>;
+    finalizeExecutedToolCall(context: AgentContext, assistant: AssistantMessage, prepared: Prepared, executed: Outcome, config: AgentLoopConfig, signal?: AbortSignal): Promise<Finalized>;
+    createErrorToolResult(message: string): AgentToolResult<unknown>;
+    createToolResultMessage(finalized: Finalized): ToolResultMessage;
+    emitToolExecutionEnd(finalized: Finalized, emit: Emit): Promise<void>;
+}
+/** Native-only driver. The ordinary loop and its provider registration remain unchanged. */
+export declare function runOpenAIExchangeLoop(
+    context: AgentContext,
+    newMessages: AgentMessage[],
+    config: AgentLoopConfig,
+    signal: AbortSignal | undefined,
+    emit: Emit,
+    helpers: NativeToolHelpers,
+): Promise<void>;
