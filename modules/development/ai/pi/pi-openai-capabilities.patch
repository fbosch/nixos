+import { AssistantMessageEventStream, convertResponsesMessages, processResponsesStream } from "@earendil-works/pi-ai";
+
+const PROVIDERS = new Set(["openai", "openai-codex", "opencode"]);
+const TERMINAL = new Set(["response.completed", "response.incomplete", "response.failed", "response.cancelled"]);
+const snapshot = (value) => structuredClone(value);
+const isCall = (item) => item?.type === "function_call" || item?.type === "custom_tool_call";
+
+// Acknowledgement means the parser has applied the event, not merely received it.
+class ParserInput {
+    waiting;
+    queued;
+    ended = false;
+    async push(event) {
+        await new Promise((resolve) => {
+            this.queued = { event, resolve };
+            this.waiting?.();
+            this.waiting = undefined;
+        });
+    }
+    end() { this.ended = true; this.waiting?.(); }
+    async *[Symbol.asyncIterator]() {
+        while (!this.ended) {
+            if (!this.queued) await new Promise((resolve) => this.waiting = resolve);
+            if (!this.queued) continue;
+            const entry = this.queued;
+            this.queued = undefined;
+            try { yield entry.event; }
+            finally { entry.resolve(); }
+        }
+    }
+}
+
+function createOutput(model, openAI) {
+    return {
+        role: "assistant", content: [], api: model.api, provider: model.provider, model: model.id,
+        usage: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, totalTokens: 0,
+            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 } },
+        stopReason: "pending", timestamp: Date.now(), openAI,
+    };
+}
+
+function strictCall(item, options) {
+    if (typeof item.call_id !== "string" || !item.call_id || typeof item.id !== "string" || !item.id || typeof item.name !== "string" || !item.name)
+        throw new Error("OpenAI native tool call is missing its correlation id or name");
+    const call = { type: "toolCall", id: `${item.call_id}|${item.id}`, name: item.name, arguments: {},
+        ...(item.namespace !== undefined ? { namespace: item.namespace } : {}),
+        ...(typeof item.async === "boolean" ? { async: item.async } : {}) };
+    let error;
+    if (item.type === "function_call") {
+        try {
+            if (typeof item.arguments !== "string") throw new Error();
+            const args = JSON.parse(item.arguments);
+            if (!args || typeof args !== "object" || Array.isArray(args)) throw new Error();
+            call.arguments = args;
+        } catch { error = "Native function call arguments must be complete JSON containing an object"; }
