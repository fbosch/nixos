--- /dev/null
+++ b/dist/core/openai-capabilities.js
@@ -0,0 +1,215 @@
+export const OPENAI_CHECKPOINT_TYPE = "openai-capabilities-v1";
+
+export function snapshotOpenAICapabilities(value) {
+  if (
+    !value ||
+    typeof value.provider !== "string" ||
+    !value.provider.trim() ||
+    typeof value.model !== "string" ||
+    !value.model.trim() ||
+    typeof value.asyncTools !== "boolean" ||
+    typeof value.steering !== "boolean"
+  ) {
+    throw new Error(
+      "OpenAI capabilities require nonempty provider/model and boolean asyncTools/steering.",
+    );
+  }
+  const names = value.asyncToolNames;
+  if (
+    names !== undefined &&
+    (!value.asyncTools ||
+      !Array.isArray(names) ||
+      names.some((name) => typeof name !== "string" || !name.trim()) ||
+      new Set(names).size !== names.length)
+  ) {
+    throw new Error(
+      "asyncToolNames requires asyncTools and unique nonempty tool names.",
+    );
+  }
+  return Object.freeze({
+    provider: value.provider,
+    model: value.model,
+    asyncTools: value.asyncTools,
+    steering: value.steering,
+    ...(names === undefined
+      ? {}
+      : { asyncToolNames: Object.freeze([...names]) }),
+  });
+}
+
+export function openAISelector(provider, model) {
+  return JSON.stringify([provider, model]);
+}
+
+export function isOpenAICheckpoint(entry) {
+  return (
+    entry.type === "custom" &&
+    entry.customType === OPENAI_CHECKPOINT_TYPE &&
+    entry.data?.version === 1 &&
+    typeof entry.data.exchangeId === "string"
+  );
+}
+
+/** Merge at the first observed position: a terminal message must not move behind its tool results. */
+export function recoverOpenAIContext(entries, project) {
+  const slots = [];
+  const indexed = new Map();
+  const calls = new Map();
+  const deliveries = new Map();
+  const visibleDeliveries = new Set();
+  const keyOf = (message) => {
+    const meta = message.openAI;
+    if (!meta?.exchangeId) return undefined;
+    if (message.role === "assistant")
+      return JSON.stringify([
+        meta.exchangeId,
+        "assistant",
+        meta.responseId ?? message.timestamp,
+      ]);
+    if (message.role === "toolResult")
+      return JSON.stringify([meta.exchangeId, "result", message.toolCallId]);
+    if (message.role === "user" && meta.deliveryId)
+      return JSON.stringify(["delivery", meta.deliveryId]);
+    return undefined;
+  };
+  const add = (message, terminal = false) => {
+    const key = keyOf(message);
+    const existing = key && indexed.get(key);
+    if (existing) {
+      if (!existing.terminal || terminal) {
+        existing.message = message;
+        existing.terminal = terminal;
+      }
+      return existing;
+    }
+    const slot = { message, terminal };
+    slots.push(slot);
+    if (key) indexed.set(key, slot);
+    return slot;
+  };
+  for (const entry of entries) {
+    if (!isOpenAICheckpoint(entry)) {
+      for (const message of project(entry)) {
+        add(message, true);
+        if (
+          message.role === "custom" &&
+          message.customType === OPENAI_CHECKPOINT_TYPE
+        ) {
+          for (const pending of message.details?.messages ?? []) {
+            if (pending.openAI?.deliveryId)
+              visibleDeliveries.add(pending.openAI.deliveryId);
+          }
+        }
+        if (message.role === "user" && message.openAI?.deliveryId)
+          deliveries.delete(message.openAI.deliveryId);
+      }
+      continue;
+    }
+    const cp = entry.data;
+    const meta = {
+      version: 1,
+      exchangeId: cp.exchangeId,
+      ...(cp.responseId ? { responseId: cp.responseId } : {}),
+    };
+    if (cp.assistant) {
+      const assistant = structuredClone(cp.assistant);
+      assistant.openAI = { ...meta, ...assistant.openAI };
+      // An interrupted snapshot must remain projectable as history, not a retryable failed response.
+      if (
+        assistant.stopReason === "pending" ||
+        assistant.stopReason === "error" ||
+        assistant.stopReason === "aborted"
+      ) {
+        assistant.stopReason = "error";
+        assistant.openAI.nonRetryable = true;
+      }
+      // Tool completion carries its pre-execution snapshot, which can be older than a sibling's intent.
+      if (cp.phase !== "call_complete" || !indexed.has(keyOf(assistant)))
+        add(assistant);
+    }
+    if (cp.callId && cp.assistant) {
+      const call = cp.assistant.content?.find(
+        (block) => block.type === "toolCall" && block.id === cp.callId,
+      );
+      if (call)
+        calls.set(JSON.stringify([cp.exchangeId, "result", cp.callId]), {
+          call,
+          meta,
+          timestamp: cp.assistant.timestamp,
+        });
+    }
+    if (cp.result)
+      add({
+        ...structuredClone(cp.result),
+        openAI: { ...meta, ...cp.result.openAI },
+      });
+    if (typeof cp.phase === "string" && cp.phase.startsWith("steer_")) {
+      for (const message of cp.messages ?? []) {
+        const id = message.openAI?.deliveryId;
+        if (!id) continue;
+        if (cp.phase === "steer_incorporated") {
+          deliveries.delete(id);
+          add({
+            ...structuredClone(message),
+            openAI: {
+              ...meta,
+              ...message.openAI,
+              deliveryStatus: "incorporated",
+            },
+          });
+        } else {
+          deliveries.set(id, {
+            cp,
+            message,
+            timestamp: Date.parse(entry.timestamp),
+          });
+        }
+      }
+    }
+  }
+  for (const [key, { call, meta, timestamp }] of calls) {
+    if (indexed.has(key)) continue;
+    const result = {
+      role: "toolResult",
+      toolCallId: call.id,
+      toolName: call.name,
+      content: [
+        {
+          type: "text",
+          text: "Tool outcome unknown after interruption. Do not execute this call again; inspect the affected state before deciding what to do next.",
+        },
+      ],
+      isError: true,
+      timestamp,
+      openAI: { ...meta, nonRetryable: true },
+    };
+    const assistantIndex = slots.findIndex(
+      (slot) =>
+        slot.message.role === "assistant" &&
+        slot.message.openAI?.exchangeId === meta.exchangeId &&
+        slot.message.content?.some(
+          (block) => block.type === "toolCall" && block.id === call.id,
+        ),
+    );
+    slots.splice(assistantIndex + 1, 0, { message: result, terminal: false });
+  }
+  for (const [id, { cp, message, timestamp }] of deliveries) {
+    if (visibleDeliveries.has(id)) continue;
+    slots.push({
+      message: {
+        role: "custom",
+        customType: OPENAI_CHECKPOINT_TYPE,
+        display: true,
+        content:
+          "Steering delivery was not confirmed. Review the response before explicitly resending the pending input; it will not be sent automatically.",
+        details: {
+          deliveryStatus: "uncertain",
+          messages: [structuredClone(message)],
+          exchangeId: cp.exchangeId,
+        },
+        timestamp,
+      },
+    });
+  }
+  return slots.map((slot) => slot.message);
+}
