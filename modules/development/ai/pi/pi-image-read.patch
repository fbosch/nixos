+export interface ImageDimensions {
+	width: number;
+	height: number;
+}
+
+/**
+ * Read pixel dimensions from a PNG, GIF, WebP, or baseline/progressive JPEG header.
+ * Returns undefined for other formats and for files without their end marker, so
+ * callers fall back to a full decode that rejects truncated images.
+ */
+export function readImageDimensions(bytes: Uint8Array): ImageDimensions | undefined {
+	return readPngDimensions(bytes) ?? readGifDimensions(bytes) ?? readWebpDimensions(bytes) ?? readJpegDimensions(bytes);
+}
+
+const PNG_SIGNATURE = [0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a];
+const PNG_IEND = [0x49, 0x45, 0x4e, 0x44];
+
+function hasBytes(bytes: Uint8Array, offset: number, expected: readonly number[]): boolean {
+	if (offset < 0 || offset + expected.length > bytes.length) return false;
+	return expected.every((value, index) => bytes[offset + index] === value);
+}
+
+function hasAscii(bytes: Uint8Array, offset: number, text: string): boolean {
+	return hasBytes(bytes, offset, Array.from(text, (char) => char.charCodeAt(0)));
+}
+
+function readUint16BE(bytes: Uint8Array, offset: number): number {
+	return (bytes[offset] << 8) | bytes[offset + 1];
+}
+
+function readUint16LE(bytes: Uint8Array, offset: number): number {
+	return bytes[offset] | (bytes[offset + 1] << 8);
+}
+
+function readUint24LE(bytes: Uint8Array, offset: number): number {
+	return bytes[offset] | (bytes[offset + 1] << 8) | (bytes[offset + 2] << 16);
+}
+
+function readUint32BE(bytes: Uint8Array, offset: number): number {
+	return ((bytes[offset] << 24) | (bytes[offset + 1] << 16) | (bytes[offset + 2] << 8) | bytes[offset + 3]) >>> 0;
+}
+
+function readUint32LE(bytes: Uint8Array, offset: number): number {
+	return (bytes[offset] | (bytes[offset + 1] << 8) | (bytes[offset + 2] << 16) | (bytes[offset + 3] << 24)) >>> 0;
+}
+
+function dimensions(width: number, height: number): ImageDimensions | undefined {
+	return width > 0 && height > 0 ? { width, height } : undefined;
+}
+
+function readPngDimensions(bytes: Uint8Array): ImageDimensions | undefined {
+	if (!hasBytes(bytes, 0, PNG_SIGNATURE) || bytes.length < 33) return undefined;
+	if (readUint32BE(bytes, 8) !== 13 || !hasAscii(bytes, 12, "IHDR")) return undefined;
+	// The IEND chunk is the last 12 bytes: length, type, and CRC.
+	if (!hasBytes(bytes, bytes.length - 8, PNG_IEND)) return undefined;
+	return dimensions(readUint32BE(bytes, 16), readUint32BE(bytes, 20));
+}
+
+function readGifDimensions(bytes: Uint8Array): ImageDimensions | undefined {
+	if (!hasAscii(bytes, 0, "GIF87a") && !hasAscii(bytes, 0, "GIF89a")) return undefined;
+	if (bytes.length < 14 || bytes[bytes.length - 1] !== 0x3b) return undefined;
+	return dimensions(readUint16LE(bytes, 6), readUint16LE(bytes, 8));
+}
+
+function readWebpDimensions(bytes: Uint8Array): ImageDimensions | undefined {
+	if (!hasAscii(bytes, 0, "RIFF") || !hasAscii(bytes, 8, "WEBP") || bytes.length < 30) return undefined;
+	if (readUint32LE(bytes, 4) + 8 !== bytes.length) return undefined;
+	const data = 20;
+	if (hasAscii(bytes, 12, "VP8X")) {
+		return dimensions(readUint24LE(bytes, data + 4) + 1, readUint24LE(bytes, data + 7) + 1);
+	}
+	if (hasAscii(bytes, 12, "VP8L")) {
+		if (bytes[data] !== 0x2f) return undefined;
+		const bits = readUint32LE(bytes, data + 1);
+		return dimensions((bits & 0x3fff) + 1, ((bits >>> 14) & 0x3fff) + 1);
+	}
+	if (hasAscii(bytes, 12, "VP8 ")) {
+		if (!hasBytes(bytes, data + 3, [0x9d, 0x01, 0x2a])) return undefined;
+		return dimensions(readUint16LE(bytes, data + 6) & 0x3fff, readUint16LE(bytes, data + 8) & 0x3fff);
+	}
+	return undefined;
+}
+
+// Baseline, extended sequential, and progressive Huffman frames. Rarer encodings take the decode path.
+const JPEG_DECODABLE_FRAMES = new Set([0xc0, 0xc1, 0xc2]);
+
+function readJpegDimensions(bytes: Uint8Array): ImageDimensions | undefined {
+	if (!hasBytes(bytes, 0, [0xff, 0xd8]) || !hasBytes(bytes, bytes.length - 2, [0xff, 0xd9])) return undefined;
