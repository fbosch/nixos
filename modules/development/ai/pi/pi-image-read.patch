+	while (offset + 4 <= bytes.length) {
+		if (bytes[offset] !== 0xff) return undefined;
+		const marker = bytes[offset + 1];
+		if (marker === 0xff) {
+			offset++;
+			continue;
+		}
+		if (marker === 0xd8 || marker === 0xd9 || marker === 0xda) return undefined;
+		if (marker === 0x01 || (marker >= 0xd0 && marker <= 0xd7)) {
+			offset += 2;
+			continue;
+		}
+		const length = readUint16BE(bytes, offset + 2);
+		if (length < 2 || offset + 2 + length > bytes.length) return undefined;
+		if (marker >= 0xc0 && marker <= 0xcf && marker !== 0xc4 && marker !== 0xc8 && marker !== 0xcc) {
+			if (!JPEG_DECODABLE_FRAMES.has(marker) || length < 7) return undefined;
+			return dimensions(readUint16BE(bytes, offset + 7), readUint16BE(bytes, offset + 5));
+		}
+		offset += 2 + length;
+	}
+	return undefined;
+}
