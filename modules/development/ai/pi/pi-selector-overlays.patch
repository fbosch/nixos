+class SelectorOverlayComponent implements Component, Focusable {
+	wantsKeyRelease = false;
+	private focusedComponent: Component;
+	private focus: Component;
+	private _focused = false;
+	constructor(component: Component, focus: Component) {
+		this.focusedComponent = component;
+		this.focus = focus;
+		this.wantsKeyRelease = "wantsKeyRelease" in focus && focus.wantsKeyRelease === true;
+	}
+	get focused(): boolean {
+		return this._focused;
+	}
+	set focused(value: boolean) {
+		this._focused = value;
+		if (isFocusable(this.focus)) this.focus.focused = value;
+	}
+	render(width: number): string[] {
+		const paddingX = width > 2 ? 1 : 0;
+		const contentWidth = Math.max(1, width - paddingX * 2);
+		const background = theme.getBgAnsi("customMessageBg");
+		return this.focusedComponent.render(contentWidth).map((line) => {
+			const panelLine = line
+				.replaceAll("\x1b[0m", `\x1b[0m${background}`)
+				.replaceAll("\x1b[49m", `\x1b[49m${background}`);
+			const fillWidth = Math.max(0, contentWidth - visibleWidth(line));
+			return `${background}${" ".repeat(paddingX)}${panelLine}${" ".repeat(fillWidth + paddingX)}\x1b[49m`;
+		});
+	}
+	handleInput(data: string): void {
+		this.focus.handleInput?.(data);
+	}
+	invalidate(): void {
+		this.focusedComponent.invalidate();
+	}
