diff --git a/packages/coding-agent/src/core/credential-refs.ts b/packages/coding-agent/src/core/credential-refs.ts
new file mode 100644
index 0000000..9c5b9bb
--- /dev/null
+++ b/packages/coding-agent/src/core/credential-refs.ts
@@ -0,0 +1,160 @@
+/**
+ * Credential references for executor mode. The executor replaces secret values with opaque
+ * references before anything reaches the sandbox, and swaps them back when the sandbox hands a
+ * reference to an executor operation. References are scoped to the provider that issued them.
+ */
+import { randomBytes } from "node:crypto";
+import type { AuthResult, ModelAuth, ProviderHeaders } from "@earendil-works/pi-ai";
+
+const PREFIX = "piref_";
+const REF_PATTERN = /piref_[A-Za-z0-9_-]{43}/g;
+const SECRET_FIELD = /token|secret|key|access|refresh|password|credential/i;
+const REFRESH_FIELD = /refresh/i;
+const SECRET_HEADER = /^(authorization|proxy-authorization|cookie|api-key)$|key|token|secret|auth|signature|credential|password/i;
+
+export function containsCredentialRef(value: string): boolean {
+	return value.includes(PREFIX) && new RegExp(REF_PATTERN.source).test(value);
+}
+
+export function isSecretHeader(name: string): boolean {
+	return SECRET_HEADER.test(name);
+}
+
+interface Entry {
+	value: string;
+	provider: string;
+	/** Bearer values may be substituted into requests; refresh tokens only flow back into storage. */
+	substitutable: boolean;
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+	return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+export class CredentialRefRegistry {
+	readonly #entries = new Map<string, Entry>();
+	readonly #refs = new Map<string, string>();
+
+	/** The reference for `value`, stable for the lifetime of this registry. */
+	register(provider: string, value: string, substitutable: boolean): string {
+		const key = `${provider}\0${substitutable ? "s" : "r"}\0${value}`;
+		const existing = this.#refs.get(key);
+		if (existing) return existing;
+		const ref = `${PREFIX}${randomBytes(32).toString("base64url").slice(0, 43)}`;
+		this.#entries.set(ref, { value, provider, substitutable });
+		this.#refs.set(key, ref);
+		return ref;
+	}
+
+	lookup(ref: string): Readonly<Entry> | undefined {
+		return this.#entries.get(ref);
+	}
+
+	/** Every secret value this registry has seen, longest first, for scrubbing relayed data. */
+	secrets(): string[] {
+		return [...new Set([...this.#entries.values()].map((entry) => entry.value))].sort((a, b) => b.length - a.length);
+	}
+
+	/** Replaces secret fields of a stored credential, recursively, with references. */
+	redactCredential(provider: string, credential: unknown): unknown {
+		const walk = (value: unknown, secretContext: boolean, refresh: boolean): unknown => {
+			if (typeof value === "string") {
+				return secretContext && value.length > 0 ? this.register(provider, value, !refresh) : value;
+			}
+			if (Array.isArray(value)) return value.map((item) => walk(item, false, false));
+			if (!isRecord(value)) return value;
+			const result: Record<string, unknown> = {};
+			for (const [key, item] of Object.entries(value)) {
+				result[key] = walk(item, SECRET_FIELD.test(key), REFRESH_FIELD.test(key));
+			}
+			return result;
+		};
+		return walk(credential, false, false);
+	}
+
+	redactModelAuth(provider: string, auth: ModelAuth): ModelAuth {
+		return {
+			...(auth.apiKey === undefined ? {} : { apiKey: this.register(provider, auth.apiKey, true) }),
+			...(auth.headers === undefined ? {} : { headers: this.#redactHeaders(provider, auth.headers) }),
+			...(auth.baseUrl === undefined ? {} : { baseUrl: auth.baseUrl }),
+		};
+	}
+
+	redactAuthResult(provider: string, result: AuthResult): AuthResult {
+		return {
+			auth: this.redactModelAuth(provider, result.auth),
+			...(result.env === undefined ? {} : { env: this.redactCredential(provider, result.env) as Record<string, string> }),
+			...(result.source === undefined ? {} : { source: result.source }),
+		};
+	}
+
+	#redactHeaders(provider: string, headers: ProviderHeaders): ProviderHeaders {
+		const redacted: ProviderHeaders = {};
+		for (const [name, value] of Object.entries(headers)) {
+			redacted[name] = typeof value === "string" && isSecretHeader(name) ? this.register(provider, value, true) : value;
+		}
+		return redacted;
+	}
+
+	/**
+	 * Replaces references in a credential the sandbox hands back. A reference may stand only where
+	 * `redactCredential` puts one: a string directly under a secret field. Anywhere else it is
+	 * rejected, because the secret would land in a field that reads return unmasked. Refresh-token
+	 * references are accepted only under refresh fields, so they cannot become bearer values.
+	 */
+	rehydrateCredential(provider: string, credential: unknown): unknown {
+		const walk = (value: unknown, secretContext: boolean, refresh: boolean): unknown => {
+			if (typeof value === "string") {
+				if (!containsCredentialRef(value)) return value;
+				if (!secretContext) throw new Error("Credential references may only appear in credential fields");
+				return this.rehydrateString(provider, value, { allowRefresh: refresh });
+			}
+			if (Array.isArray(value)) return value.map((item) => walk(item, false, false));
+			if (!isRecord(value)) return value;
+			const result: Record<string, unknown> = {};
+			for (const [key, item] of Object.entries(value)) {
+				result[key] = walk(item, SECRET_FIELD.test(key), REFRESH_FIELD.test(key));
+			}
+			return result;
+		};
+		return walk(credential, false, false);
+	}
+
+	/**
+	 * Replaces references inside `value` with their secrets. Every reference must belong to
+	 * `provider`; refresh-token references are accepted only when `allowRefresh` is set.
+	 */
+	rehydrate<T>(provider: string, value: T, options: { allowRefresh: boolean }): T {
+		const walk = (item: unknown): unknown => {
+			if (typeof item === "string") return this.rehydrateString(provider, item, options);
+			if (Array.isArray(item)) return item.map(walk);
+			if (!isRecord(item)) return item;
+			const result: Record<string, unknown> = {};
+			for (const [key, entry] of Object.entries(item)) result[key] = walk(entry);
+			return result;
+		};
+		return walk(value) as T;
+	}
+
+	rehydrateString(provider: string, value: string, options: { allowRefresh: boolean }): string {
+		if (!value.includes(PREFIX)) return value;
+		return value.replace(new RegExp(REF_PATTERN.source, "g"), (ref) => {
+			const entry = this.#entries.get(ref);
+			if (!entry) throw new Error("Unknown credential reference");
+			if (entry.provider !== provider) throw new Error(`Credential reference does not belong to ${provider}`);
+			if (!entry.substitutable && !options.allowRefresh) throw new Error("Refresh tokens cannot be sent in requests");
+			return entry.value;
+		});
+	}
+
+	/** Providers whose references appear in `value`. Unknown references throw. */
+	providersIn(value: string): Set<string> {
+		const providers = new Set<string>();
+		for (const ref of value.match(new RegExp(REF_PATTERN.source, "g")) ?? []) {
+			const entry = this.#entries.get(ref);
+			if (!entry) throw new Error("Unknown credential reference");
+			providers.add(entry.provider);
+		}
+		return providers;
+	}
+}
diff --git a/packages/coding-agent/src/core/executor-credentials.ts b/packages/coding-agent/src/core/executor-credentials.ts
new file mode 100644
index 0000000..58db2bf
--- /dev/null
+++ b/packages/coding-agent/src/core/executor-credentials.ts
@@ -0,0 +1,145 @@
+/**
+ * Sandbox side of executor credentials. In executor mode, credential files are read and written
+ * through the executor, provider auth runs there, and requests that carry credential references go
+ * through it. Code that uses Pi's credential stores and `fetch` works unchanged; it only ever holds
+ * references.
+ */
+import type {
+	ApiKeyAuth,
+	ApiKeyCredential,
+	AuthCheck,
+	AuthResult,
+	ModelAuth,
+	OAuthAuth,
+	OAuthCredential,
+	Provider,
+} from "@earendil-works/pi-ai";
+import type { AuthStorageBackend } from "./auth-storage.ts";
+import { containsCredentialRef } from "./credential-refs.ts";
+import { MODEL_EXECUTOR_SOCKET_ENV, ModelExecutorClient } from "./model-executor.ts";
+
+type LockResult<T> = { result: T; next?: string };
+
+/** The executor socket in executor mode. Read per call: bundled and unbundled copies share it. */
+export function executorSocket(): string | undefined {
+	return process.env[MODEL_EXECUTOR_SOCKET_ENV] || undefined;
+}
+
+/** A credential file held by the executor: its content arrives with references in place of secrets. */
+export class ExecutorAuthStorageBackend implements AuthStorageBackend {
+	readonly #client: ModelExecutorClient;
+	readonly #path: string;
+	#reading: Promise<string | undefined> | undefined;
+
+	constructor(client: ModelExecutorClient, path: string) {
+		this.#client = client;
+		this.#path = path;
+	}
+
+	withLock<T>(_fn: (current: string | undefined) => LockResult<T>): T {
+		throw new Error("Executor-held credentials are only available asynchronously");
+	}
+
+	/** Concurrent reads share one executor round trip; writes still take the file lock. */
+	read(options?: { signal?: AbortSignal }): Promise<string | undefined> {
+		options?.signal?.throwIfAborted();
+		if (!this.#reading) {
+			const reading = this.#client.readCredentialFile(this.#path);
+			this.#reading = reading;
+			void reading.then(
+				() => this.#clearRead(reading),
+				() => this.#clearRead(reading),
+			);
+		}
+		return this.#reading;
+	}
+
+	#clearRead(reading: Promise<string | undefined>): void {
+		if (this.#reading === reading) this.#reading = undefined;
+	}
+
+	withLockAsync<T>(
+		fn: (current: string | undefined) => Promise<LockResult<T>>,
+		options?: { signal?: AbortSignal },
+	): Promise<T> {
+		return this.#client.lockCredentialFile(this.#path, fn, options?.signal);
+	}
+}
+
+/** The executor-held backend for `path` in executor mode; undefined otherwise. */
+export function executorAuthStorageBackend(path: string): ExecutorAuthStorageBackend | undefined {
+	const socket = executorSocket();
+	return socket ? new ExecutorAuthStorageBackend(new ModelExecutorClient(socket), path) : undefined;
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+	return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function authCheck(value: unknown): AuthCheck | undefined {
+	if (!isRecord(value) || (value.type !== "api_key" && value.type !== "oauth")) return undefined;
+	return typeof value.source === "string" ? { type: value.type, source: value.source } : { type: value.type };
+}
+
+/**
+ * The provider with its auth methods running on the executor. Credentials passed in and returned
+ * hold references, so auth flows such as locked OAuth refresh keep their semantics here.
+ */
+export function withExecutorAuth(provider: Provider, client: ModelExecutorClient): Provider {
+	const { apiKey, oauth } = provider.auth;
+	const call = (method: string, credential: unknown, signal?: AbortSignal) =>
+		client.providerAuth(provider.id, method, credential, signal);
+	const executorApiKey: ApiKeyAuth | undefined = apiKey && {
+		name: apiKey.name,
+		...(apiKey.login
+			? {
+					login: async (interaction) =>
+						(await client.login(provider.id, "apiKey", interaction)) as unknown as ApiKeyCredential,
+				}
+			: {}),
+		...(apiKey.check
+			? { check: async ({ credential, signal }) => authCheck(await call("apiKey.check", credential, signal)) }
+			: {}),
+		resolve: async ({ credential, signal }) =>
+			((await call("apiKey.resolve", credential, signal)) ?? undefined) as AuthResult | undefined,
+	};
+	const executorOAuth: OAuthAuth | undefined = oauth && {
+		name: oauth.name,
+		...(oauth.isSubscription === undefined ? {} : { isSubscription: oauth.isSubscription }),
+		...(oauth.loginLabel === undefined ? {} : { loginLabel: oauth.loginLabel }),
+		login: async (interaction, options) =>
+			(await client.login(provider.id, "oauth", interaction, options)) as OAuthCredential,
+		refresh: async (credential, signal) => (await call("oauth.refresh", credential, signal)) as OAuthCredential,
+		toAuth: async (credential) => (await call("oauth.toAuth", credential)) as ModelAuth,
+	};
+	return {
+		...provider,
+		auth: { ...(executorApiKey ? { apiKey: executorApiKey } : {}), ...(executorOAuth ? { oauth: executorOAuth } : {}) },
+	};
+}
+
+const FETCH_SHIM = Symbol.for("pi.executorCredentialFetch");
+const FETCH_CLIENT = Symbol.for("pi.executorCredentialFetchClient");
+
+/**
+ * Routes requests whose URL or headers carry credential references through the executor, which swaps
+ * the references for secrets and sends the request only to the credential provider's origins.
+ * Other requests use the original `fetch`. Installed once per process.
+ */
+export function installExecutorFetch(client: ModelExecutorClient): void {
+	const scope = globalThis as typeof globalThis & { [FETCH_SHIM]?: true; [FETCH_CLIENT]?: ModelExecutorClient };
+	// Bundled and unbundled copies share one shim; the latest client serves it.
+	scope[FETCH_CLIENT] = client;
+	if (scope[FETCH_SHIM]) return;
+	scope[FETCH_SHIM] = true;
+	const original = globalThis.fetch.bind(globalThis);
+	const shim = async (input: string | URL | Request, init?: RequestInit) => {
+		// Inspect the URL and headers without building a Request, which would consume a streamed body.
+		const url = input instanceof Request ? input.url : String(input);
+		const headers = new Headers(init?.headers ?? (input instanceof Request ? input.headers : undefined));
+		const carriesReference = containsCredentialRef(url) || [...headers.values()].some(containsCredentialRef);
+		const executor = scope[FETCH_CLIENT];
+		return carriesReference && executor ? executor.fetch(new Request(input, init)) : original(input, init);
+	};
+	globalThis.fetch = shim as typeof fetch;
+}
