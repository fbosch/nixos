+++ b/packages/coding-agent/src/core/model-executor.ts
@@ -0,0 +1,1324 @@
+/**
+ * Credential-free model requests for sandboxed sessions.
+ *
+ * A host process owns the credential files and runs `serveModelExecutor`. The sandboxed runtime
+ * reads and writes those files through the executor and sees opaque references in place of
+ * secrets. Provider auth methods (refresh, toAuth, resolve, login) run on the host; the sandbox
+ * still decides which credential a request uses. Model requests stream from the host, which
+ * resolves the model from its own catalog and swaps references back for secrets. Other requests
+ * that carry references go through the executor, which sends them only to the owning provider's
+ * origins. One connection carries one operation; closing it aborts the operation.
+ */
+import { lstatSync, realpathSync, symlinkSync, writeFileSync } from "node:fs";
+import { readFile } from "node:fs/promises";
+import { createConnection, type Server, type Socket } from "node:net";
+import { basename, dirname, isAbsolute, join, relative } from "node:path";
+import {
+	type Api,
+	type ApiKeyCredential,
+	type AssistantMessage,
+	type AssistantMessageEvent,
+	type AuthEvent,
+	type AuthPrompt,
+	type AuthResult,
+	type Credential,
+	defaultProviderAuthContext,
+	type LoginOptions,
+	type ModelAuth,
+	type ProviderAuthInteraction,
+	type Model,
+	type ModelsSimpleStreamOptions,
+	type ProviderHeaders,
+	type ProviderResponse,
+	type StopReason,
+	type ToolCall,
+	ToolCallArgumentsStream,
+	type TranscriptContext,
+} from "@earendil-works/pi-ai";
+import { getAgentDir } from "../config.ts";
+import { FileAuthStorageBackend } from "./auth-storage.ts";
+import { CredentialRefRegistry } from "./credential-refs.ts";
+import type { ModelRuntime } from "./model-runtime.ts";
+import { getConfigValueEnvVarNames, isCommandConfigValue, resolveConfigValue } from "./resolve-config-value.ts";
+
+export const MODEL_EXECUTOR_SOCKET_ENV = "PI_MODEL_EXECUTOR_SOCKET";
+const PROTOCOL = 1;
+const MAX_FRAME_BYTES = 64 * 1024 * 1024;
+const REDACTED = "[redacted]";
+const MIN_SECRET_LENGTH = 8;
+/** Minimum interval between catalog refreshes for a model the host catalog does not know. */
+const CATALOG_REFRESH_INTERVAL_MS = 5 * 60_000;
+
+/**
+ * Options the executor relays. Endpoint-selecting provider options, caller credentials (`apiKey`,
+ * `env`), custom `fetch`, and telemetry spans never cross the socket.
+ */
+const RELAYED_OPTIONS = [
+	"cacheRetention",
+	"headers",
+	"identity",
+	"maxRetries",
+	"maxRetryDelayMs",
+	"maxTokens",
+	"metadata",
+	"reasoning",
+	"samplingParams",
+	"sessionId",
+	"temperature",
+	"thinkingBudgets",
+	"timeoutMs",
+	"toolChoice",
+	"transport",
+	"websocketConnectTimeoutMs",
+] as const;
+
+const CREDENTIAL_HEADER = /^(authorization|proxy-authorization|cookie|api-key)$|key|token|secret|auth|signature|credential|password/i;
+const CREDENTIAL_ENV = /key|token|secret|password|credential/i;
+
+export function isCredentialHeader(name: string): boolean {
+	return CREDENTIAL_HEADER.test(name);
+}
+
+/** Credentials resolved for one request, observed by the executor before dispatch. */
+export interface ModelRequestCredentials {
+	apiKey?: string;
+	headers: ProviderHeaders;
+	env: Record<string, string>;
+}
+
+type CallbackKind = "headers" | "payload" | "response" | "provider_event";
+
+type WireEvent =
+	| { type: "start"; partial: AssistantMessage }
+	| { type: "text_start"; contentIndex: number; partial: AssistantMessage }
+	| { type: "text_delta"; contentIndex: number; delta: string }
+	| { type: "text_end"; contentIndex: number; content: string; partial: AssistantMessage }
+	| { type: "thinking_start"; contentIndex: number; partial: AssistantMessage }
+	| { type: "thinking_delta"; contentIndex: number; delta: string }
+	| { type: "thinking_end"; contentIndex: number; content: string; partial: AssistantMessage }
+	| { type: "toolcall_start"; contentIndex: number; partial: AssistantMessage }
+	| { type: "toolcall_delta"; contentIndex: number; delta: string }
+	| { type: "toolcall_end"; contentIndex: number; toolCall: ToolCall; partial: AssistantMessage }
+	| { type: "done"; reason: Extract<StopReason, "stop" | "length" | "toolUse" | "deferred">; message: AssistantMessage }
+	| { type: "error"; reason: Extract<StopReason, "aborted" | "error">; error: AssistantMessage };
+
+type Frame = Record<string, unknown> & { type: string };
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+	return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function isFrame(value: unknown): value is Frame {
+	return isRecord(value) && typeof value.type === "string";
+}
+
+/** Newline-delimited JSON frames with a per-frame size limit. */
+function readFrames(socket: Socket, onFrame: (frame: Frame) => void, onError: (error: Error) => void): void {
+	let pending: Buffer[] = [];
+	let pendingBytes = 0;
+	let failed = false;
+	const fail = (message: string) => {
+		if (failed) return;
+		failed = true;
+		onError(new Error(message));
+	};
+	socket.on("data", (chunk: Buffer) => {
+		if (failed) return;
+		let start = 0;
+		for (let end = chunk.indexOf(10, start); end !== -1; end = chunk.indexOf(10, start)) {
+			const line = Buffer.concat([...pending, chunk.subarray(start, end)]);
+			pending = [];
+			pendingBytes = 0;
+			start = end + 1;
+			if (line.length > MAX_FRAME_BYTES) return fail("Model executor frame exceeds the size limit");
+			let frame: unknown;
+			try {
+				frame = JSON.parse(line.toString("utf8"));
+			} catch {
+				return fail("Model executor sent an invalid frame");
+			}
+			if (!isFrame(frame)) return fail("Model executor sent an invalid frame");
+			onFrame(frame);
+			if (failed) return;
+		}
+		const rest = chunk.subarray(start);
+		pendingBytes += rest.length;
+		if (pendingBytes > MAX_FRAME_BYTES) return fail("Model executor frame exceeds the size limit");
+		if (rest.length > 0) pending.push(rest);
+	});
+}
+
+async function writeFrame(socket: Socket, frame: Frame, transform?: (text: string) => string): Promise<void> {
+	if (socket.destroyed || socket.writableEnded) throw new Error("Model executor connection is closed");
+	const text = JSON.stringify(frame);
+	if (socket.write(`${transform ? transform(text) : text}\n`)) return;
+	await new Promise<void>((resolve, reject) => {
+		const cleanup = () => {
+			socket.off("drain", onDrain);
+			socket.off("close", onClose);
+		};
+		const onDrain = () => {
+			cleanup();
+			resolve();
+		};
+		const onClose = () => {
+			cleanup();
+			reject(new Error("Model executor connection is closed"));
+		};
+		socket.on("drain", onDrain);
+		socket.on("close", onClose);
+	});
+}
+
+class FrameQueue {
+	readonly #items: Frame[] = [];
+	readonly #waiters: Array<{ resolve: (frame: Frame | undefined) => void; reject: (error: Error) => void }> = [];
+	#error: Error | undefined;
+	#closed = false;
+
+	push(frame: Frame): void {
+		const waiter = this.#waiters.shift();
+		if (waiter) waiter.resolve(frame);
+		else this.#items.push(frame);
+	}
+
+	fail(error: Error): void {
+		if (this.#error || this.#closed) return;
+		this.#error = error;
+		for (const waiter of this.#waiters.splice(0)) waiter.reject(error);
+	}
+
+	close(): void {
+		this.#closed = true;
+		for (const waiter of this.#waiters.splice(0)) {
+			if (this.#error) waiter.reject(this.#error);
+			else waiter.resolve(undefined);
+		}
+	}
+
+	next(): Promise<Frame | undefined> {
+		const item = this.#items.shift();
+		if (item) return Promise.resolve(item);
+		if (this.#error) return Promise.reject(this.#error);
+		if (this.#closed) return Promise.resolve(undefined);
+		return new Promise((resolve, reject) => this.#waiters.push({ resolve, reject }));
+	}
+}
+
+function relayedOptions(options: object | undefined): Record<string, unknown> {
+	const source = new Map(Object.entries(options ?? {}));
+	const relayed: Record<string, unknown> = {};
+	for (const name of RELAYED_OPTIONS) {
+		const value = source.get(name);
+		if (value !== undefined) relayed[name] = value;
+	}
+	return relayed;
+}
+
+function errorMessage(error: unknown): string {
+	return error instanceof Error ? error.message : String(error);
+}
+
+function replaceObject(target: Record<string, unknown>, source: Record<string, unknown>): void {
+	for (const key of Object.keys(target)) if (!(key in source)) delete target[key];
+	Object.assign(target, source);
+}
+
+/**
+ * Rebuilds the provider's live `partial` message. Structural events carry the whole message; text,
+ * thinking, and tool-call deltas carry only their delta, so streaming stays linear in output size.
+ */
+class RemoteMessage {
+	#partial: AssistantMessage | undefined;
+	readonly #arguments = new Map<number, ToolCallArgumentsStream>();
+
+	decode(event: WireEvent): AssistantMessageEvent {
+		switch (event.type) {
+			case "start":
+				return { type: "start", partial: this.#adopt(event.partial) };
+			case "text_start":
+				return { type: "text_start", contentIndex: event.contentIndex, partial: this.#adopt(event.partial) };
+			case "thinking_start":
+				return { type: "thinking_start", contentIndex: event.contentIndex, partial: this.#adopt(event.partial) };
+			case "toolcall_start":
+				this.#arguments.set(event.contentIndex, new ToolCallArgumentsStream());
+				return { type: "toolcall_start", contentIndex: event.contentIndex, partial: this.#adopt(event.partial) };
+			case "text_delta": {
+				const partial = this.#current();
+				const block = partial.content[event.contentIndex];
+				if (block?.type !== "text") throw new Error("Model executor sent text_delta for non-text content");
+				block.text += event.delta;
+				return { type: "text_delta", contentIndex: event.contentIndex, delta: event.delta, partial };
+			}
+			case "thinking_delta": {
+				const partial = this.#current();
+				const block = partial.content[event.contentIndex];
+				if (block?.type !== "thinking") {
+					throw new Error("Model executor sent thinking_delta for non-thinking content");
+				}
+				block.thinking += event.delta;
+				return { type: "thinking_delta", contentIndex: event.contentIndex, delta: event.delta, partial };
+			}
+			case "toolcall_delta": {
+				const partial = this.#current();
+				const block = partial.content[event.contentIndex];
+				if (block?.type !== "toolCall") {
+					throw new Error("Model executor sent toolcall_delta for non-toolCall content");
+				}
+				let args = this.#arguments.get(event.contentIndex);
+				if (!args) {
+					args = new ToolCallArgumentsStream();
+					this.#arguments.set(event.contentIndex, args);
+				}
+				// A new block object, so reactive consumers see the change.
+				partial.content[event.contentIndex] = { ...block, arguments: args.append(event.delta) };
+				return { type: "toolcall_delta", contentIndex: event.contentIndex, delta: event.delta, partial };
+			}
+			case "text_end":
+				return {
+					type: "text_end",
+					contentIndex: event.contentIndex,
+					content: event.content,
+					partial: this.#adopt(event.partial),
+				};
+			case "thinking_end":
+				return {
+					type: "thinking_end",
+					contentIndex: event.contentIndex,
+					content: event.content,
+					partial: this.#adopt(event.partial),
+				};
+			case "toolcall_end": {
+				const partial = this.#adopt(event.partial);
+				this.#arguments.delete(event.contentIndex);
+				const block = partial.content[event.contentIndex];
+				const toolCall = block?.type === "toolCall" ? block : event.toolCall;
+				return { type: "toolcall_end", contentIndex: event.contentIndex, toolCall, partial };
+			}
+			case "done":
+				return { type: "done", reason: event.reason, message: this.#adopt(event.message) };
+			case "error":
+				return { type: "error", reason: event.reason, error: this.#adopt(event.error) };
+		}
+	}
+
+	#current(): AssistantMessage {
+		if (!this.#partial) throw new Error("Model executor sent a delta before the message started");
+		return this.#partial;
+	}
+
+	/** Updates the live message in place: consumers keep references to it and its content blocks. */
+	#adopt(source: AssistantMessage): AssistantMessage {
+		const target = this.#partial;
+		if (!target) {
+			this.#partial = source;
+			return source;
+		}
+		const content = target.content;
+		replaceObject(target as unknown as Record<string, unknown>, { ...source, content });
+		source.content.forEach((block, index) => {
+			const existing = content[index];
+			if (existing && existing.type === block.type) {
+				replaceObject(existing as unknown as Record<string, unknown>, block as unknown as Record<string, unknown>);
+			} else {
+				content[index] = block;
+			}
+		});
+		content.length = source.content.length;
+		return target;
+	}
+}
+
+function encodeEvent(event: AssistantMessageEvent): WireEvent {
+	switch (event.type) {
+		case "text_delta":
+		case "thinking_delta":
+		case "toolcall_delta":
+			return { type: event.type, contentIndex: event.contentIndex, delta: event.delta };
+		default:
+			return event;
+	}
+}
+
+interface Connection {
+	socket: Socket;
+	frames: FrameQueue;
+}
+
+/** Sandbox side: sends requests to the executor socket. Credentials it sees are references. */
+export class ModelExecutorClient {
+	readonly socketPath: string;
+
+	constructor(socketPath: string) {
+		this.socketPath = socketPath;
+	}
+
+	/** Streams a request; `auth` is this process's resolved auth, holding references in place of secrets. */
+	streamSimple(
+		model: Model<Api>,
+		context: TranscriptContext,
+		options: ModelsSimpleStreamOptions | undefined,
+		auth: AuthResult,
+	): AsyncIterable<AssistantMessageEvent> {
+		return this.#request(model, context, options, auth);
+	}
+
+	/** Runs a provider auth method on the executor with a credential that holds references. */
+	providerAuth(providerId: string, method: string, credential: unknown, signal?: AbortSignal): Promise<unknown> {
+		return this.#call(
+			{ type: "request", protocol: PROTOCOL, operation: "provider_auth", provider: providerId, method, credential },
+			signal,
+		);
+	}
+
+	/** Sends a request whose URL or headers carry credential references through the executor. */
+	async fetch(request: Request): Promise<Response> {
+		const body = request.body ? Buffer.from(await request.arrayBuffer()).toString("base64") : undefined;
+		const { socket, frames } = this.#connect(request.signal);
+		try {
+			await writeFrame(socket, {
+				type: "request",
+				protocol: PROTOCOL,
+				operation: "fetch",
+				url: request.url,
+				method: request.method,
+				headers: [...request.headers],
+				...(body === undefined ? {} : { body }),
+			});
+			const head = await frames.next();
+			if (!head) throw new Error("Model executor closed the request before it completed");
+			if (head.type === "failure") {
+				throw new Error(typeof head.message === "string" ? head.message : "Model executor request failed");
+			}
+			if (head.type !== "head" || typeof head.status !== "number" || !Array.isArray(head.headers)) {
+				throw new Error("Model executor sent an invalid response");
+			}
+			const status = head.status;
+			const stream = new ReadableStream<Uint8Array>({
+				async pull(controller) {
+					try {
+						const frame = await frames.next();
+						if (!frame || frame.type === "end") {
+							controller.close();
+							socket.destroy();
+						} else if (frame.type === "body" && typeof frame.data === "string") {
+							controller.enqueue(new Uint8Array(Buffer.from(frame.data, "base64")));
+						} else {
+							throw new Error(typeof frame.message === "string" ? frame.message : "Model executor response failed");
+						}
+					} catch (error) {
+						controller.error(error);
+						socket.destroy();
+					}
+				},
+				cancel() {
+					socket.destroy();
+				},
+			});
+			return new Response(status === 204 || status === 304 ? null : stream, {
+				status,
+				statusText: typeof head.statusText === "string" ? head.statusText : "",
+				headers: head.headers.filter(
+					(entry): entry is [string, string] =>
+						Array.isArray(entry) && typeof entry[0] === "string" && typeof entry[1] === "string",
+				),
+			});
+		} catch (error) {
+			socket.destroy();
+			throw error;
+		}
+	}
+
+	/** Runs a provider login on the executor. Prompts and notices are relayed to `interaction`. */
+	async login(
+		providerId: string,
+		kind: "oauth" | "apiKey",
+		interaction: ProviderAuthInteraction,
+		options?: LoginOptions,
+	): Promise<unknown> {
+		const { socket, frames } = this.#connect(interaction.signal);
+		const prompts = new Map<number, AbortController>();
+		try {
+			await writeFrame(socket, {
+				type: "request",
+				protocol: PROTOCOL,
+				operation: "login",
+				provider: providerId,
+				kind,
+				...(options?.agentName === undefined ? {} : { agentName: options.agentName }),
+				...(options?.getDeviceId === undefined ? {} : { deviceId: options.getDeviceId() }),
+			});
+			while (true) {
+				const frame = await frames.next();
+				if (!frame) throw new Error("Model executor closed the login before it completed");
+				if (frame.type === "result") return frame.value;
+				if (frame.type === "failure") {
+					throw new Error(typeof frame.message === "string" ? frame.message : "Model executor login failed");
+				}
+				if (frame.type === "notify") interaction.notify(frame.event as AuthEvent);
+				else if (frame.type === "prompt_cancel" && typeof frame.id === "number") prompts.get(frame.id)?.abort();
+				else if (frame.type === "prompt" && typeof frame.id === "number") {
+					const id = frame.id;
+					const controller = new AbortController();
+					prompts.set(id, controller);
+					// Answer in the background: the executor may cancel this prompt while it is open.
+					void interaction
+						.prompt({ ...(frame.prompt as AuthPrompt), signal: controller.signal })
+						.then(
+							(value) => writeFrame(socket, { type: "prompt_result", id, value }),
+							(error) => writeFrame(socket, { type: "prompt_result", id, error: errorMessage(error) }),
+						)
+						.catch(() => {})
+						.finally(() => prompts.delete(id));
+				}
+			}
+		} finally {
+			for (const controller of prompts.values()) controller.abort();
+			socket.destroy();
+		}
+	}
+
+	/** A credential file's current content, with references in place of secrets. */
+	async readCredentialFile(path: string, signal?: AbortSignal): Promise<string | undefined> {
+		const value = await this.#call({ type: "request", protocol: PROTOCOL, operation: "credential_read", path }, signal);
+		return typeof value === "string" ? value : undefined;
+	}
+
+	/**
+	 * Holds a credential file's lock on the executor while `fn` reads its content and returns the
+	 * replacement. The content holds references; references in the replacement keep their secrets.
+	 */
+	async lockCredentialFile<T>(
+		path: string,
+		fn: (content: string | undefined) => Promise<{ result: T; next?: string }>,
+		signal?: AbortSignal,
+	): Promise<T> {
+		const { socket, frames } = this.#connect(signal);
+		try {
+			await writeFrame(socket, { type: "request", protocol: PROTOCOL, operation: "credential_lock", path });
+			const opened = await frames.next();
+			if (!opened) throw new Error("Model executor closed the credential file before it was read");
+			if (opened.type === "failure") {
+				throw new Error(typeof opened.message === "string" ? opened.message : "Model executor could not open credentials");
+			}
+			if (opened.type !== "content") throw new Error("Model executor sent an unexpected frame");
+			let outcome: { result: T; next?: string };
+			try {
+				outcome = await fn(typeof opened.content === "string" ? opened.content : undefined);
+			} catch (error) {
+				await writeFrame(socket, { type: "abort" }).catch(() => {});
+				throw error;
+			}
+			await writeFrame(socket, { type: "commit", next: outcome.next ?? null });
+			const done = await frames.next();
+			if (done?.type === "failure") {
+				throw new Error(typeof done.message === "string" ? done.message : "Model executor could not save credentials");
+			}
+			if (done?.type !== "done") throw new Error("Model executor closed the credential file before saving");
+			return outcome.result;
+		} finally {
+			socket.destroy();
+		}
+	}
+
+	#connect(signal?: AbortSignal): Connection {
+		signal?.throwIfAborted();
+		const socket = createConnection(this.socketPath);
+		const frames = new FrameQueue();
+		readFrames(
+			socket,
+			(frame) => frames.push(frame),
+			(error) => {
+				frames.fail(error);
+				socket.destroy();
+			},
+		);
+		socket.once("error", (error) => frames.fail(new Error(`Model executor connection failed: ${error.message}`)));
+		socket.once("close", () => frames.close());
+		if (signal) {
+			const abort = () => {
+				frames.fail(signal.reason instanceof Error ? signal.reason : new Error("Model executor request aborted"));
+				socket.destroy();
+			};
+			signal.addEventListener("abort", abort, { once: true });
+			socket.once("close", () => signal.removeEventListener("abort", abort));
+		}
+		return { socket, frames };
+	}
+
+	/** One request, one `result` frame. */
+	async #call(request: Frame, signal: AbortSignal | undefined): Promise<unknown> {
+		const { socket, frames } = this.#connect(signal);
+		try {
+			await writeFrame(socket, request);
+			const frame = await frames.next();
+			if (!frame) throw new Error("Model executor closed the request before it completed");
+			if (frame.type === "failure") {
+				throw new Error(typeof frame.message === "string" ? frame.message : "Model executor request failed");
+			}
+			if (frame.type !== "result") throw new Error(`Model executor sent an unexpected frame: ${frame.type}`);
+			return frame.value;
+		} finally {
+			socket.destroy();
+		}
+	}
+
+	async *#request(
+		model: Model<Api>,
+		context: TranscriptContext,
+		options: ModelsSimpleStreamOptions | undefined,
+		auth: AuthResult,
+	): AsyncGenerator<AssistantMessageEvent> {
+		const { socket, frames } = this.#connect(undefined);
+		options?.signal?.throwIfAborted();
+		const signal = options?.signal;
+		// Cancel through the executor so the provider request ends with its own aborted event.
+		const cancel = () => void writeFrame(socket, { type: "cancel" }).catch(() => {});
+		signal?.addEventListener("abort", cancel, { once: true });
+		const remote = new RemoteMessage();
+		try {
+			await writeFrame(socket, {
+				type: "request",
+				protocol: PROTOCOL,
+				operation: "streamSimple",
+				provider: model.provider,
+				modelId: model.id,
+				context,
+				options: relayedOptions(options),
+				auth: { auth: auth.auth, ...(auth.env === undefined ? {} : { env: auth.env }) },
+				callbacks: {
+					headers: options?.transformHeaders !== undefined,
+					payload: options?.onPayload !== undefined,
+					response: options?.onResponse !== undefined,
+					provider_event: options?.onProviderStreamEvent !== undefined,
+				},
+			});
+			while (true) {
+				const frame = await frames.next();
+				if (!frame) throw new Error("Model executor closed the request before it completed");
+				if (frame.type === "event") {
+					const event = remote.decode(frame.event as WireEvent);
+					yield event;
+					if (event.type === "done" || event.type === "error") return;
+				} else if (frame.type === "failure") {
+					throw new Error(typeof frame.message === "string" ? frame.message : "Model executor request failed");
+				} else {
+					await this.#callback(socket, frame, model, options);
+				}
+			}
+		} finally {
+			signal?.removeEventListener("abort", cancel);
+			socket.destroy();
+		}
+	}
+
+	async #callback(
+		socket: Socket,
+		frame: Frame,
+		model: Model<Api>,
+		options: ModelsSimpleStreamOptions | undefined,
+	): Promise<void> {
+		const kind = frame.type as CallbackKind;
+		let reply: Frame;
+		try {
+			switch (kind) {
+				case "headers": {
+					const headers = frame.headers as ProviderHeaders;
+					reply = {
+						type: "headers_result",
+						headers: options?.transformHeaders ? await options.transformHeaders(headers) : headers,
+					};
+					break;
+				}
+				case "payload": {
+					const payload = options?.onPayload ? await options.onPayload(frame.payload, model) : undefined;
+					// Returning the received object means unchanged; skip sending the payload back.
+					reply =
+						payload === undefined || payload === frame.payload
+							? { type: "payload_result", changed: false }
+							: { type: "payload_result", changed: true, payload };
+					break;
+				}
+				case "response":
+					await options?.onResponse?.(frame.response as ProviderResponse, model);
+					reply = { type: "response_result" };
+					break;
+				case "provider_event":
+					await options?.onProviderStreamEvent?.(frame.data, model);
+					reply = { type: "provider_event_result" };
+					break;
+				default:
+					throw new Error(`Model executor sent an unknown frame: ${frame.type}`);
+			}
+		} catch (error) {
+			reply = { type: `${kind}_result`, error: errorMessage(error) };
+		}
+		await writeFrame(socket, reply);
+	}
+}
+
+function credentialSecrets(credentials: ModelRequestCredentials): string[] {
+	const values: unknown[] = [credentials.apiKey];
+	for (const [name, value] of Object.entries(credentials.headers)) if (isCredentialHeader(name)) values.push(value);
+	for (const [name, value] of Object.entries(credentials.env)) if (CREDENTIAL_ENV.test(name)) values.push(value);
+	const secrets = new Set<string>();
+	for (const value of values) {
+		if (typeof value !== "string") continue;
+		for (const candidate of [value, value.replace(/^(Bearer|Basic|Token)\s+/i, "")]) {
+			if (candidate.length >= MIN_SECRET_LENGTH) {
+				secrets.add(candidate);
+				// Match the value as it appears inside serialized JSON strings.
+				secrets.add(JSON.stringify(candidate).slice(1, -1));
+			}
+		}
+	}
+	return [...secrets].sort((a, b) => b.length - a.length);
+}
+
+function filterHeaders(headers: unknown): ProviderHeaders | undefined {
+	if (!isRecord(headers)) return undefined;
+	const filtered: ProviderHeaders = {};
+	for (const [name, value] of Object.entries(headers)) {
+		if (isCredentialHeader(name)) continue;
+		if (typeof value === "string" || value === null) filtered[name] = value;
+	}
+	return filtered;
+}
+
+function parseRequest(frame: Frame): {
+	provider: string;
+	modelId: string;
+	context: TranscriptContext;
+	options: Record<string, unknown>;
+	callbacks: Record<string, boolean>;
+	auth: unknown;
+} {
+	if (typeof frame.provider !== "string" || typeof frame.modelId !== "string") {
+		throw new Error("Model executor request must name a provider and model");
+	}
+	if (!isRecord(frame.context) || !Array.isArray(frame.context.messages)) {
+		throw new Error("Model executor request has an invalid context");
+	}
+	const options = relayedOptions(isRecord(frame.options) ? frame.options : undefined);
+	const headers = filterHeaders(options.headers);
+	if (headers) options.headers = headers;
+	else delete options.headers;
+	const callbacks: Record<string, boolean> = {};
+	if (isRecord(frame.callbacks)) {
+		for (const kind of ["headers", "payload", "response", "provider_event"]) callbacks[kind] = frame.callbacks[kind] === true;
+	}
+	return {
+		provider: frame.provider,
+		modelId: frame.modelId,
+		context: { messages: frame.context.messages } as TranscriptContext,
+		options,
+		callbacks,
+		auth: frame.auth,
+	};
+}
+
+export interface ServeModelExecutorOptions {
+	/** Agent directory whose auth.json and auth-profiles/*.json the sandbox may use. Defaults to Pi's. */
+	agentDir?: string;
+	/**
+	 * Host-only directory holding the credential files. The agent directory's credential files are
+	 * symlinks into it; new profile files are created there.
+	 */
+	credentialStore?: string;
+}
+
+interface ExecutorState {
+	runtime: ModelRuntime;
+	refs: CredentialRefRegistry;
+	/** The file to open for an agent-directory credential path; `create` adds missing ones in the store. */
+	credentialFile(path: unknown, options: { create: boolean }): string;
+	/** Origins a provider's references may be sent to. */
+	origins(providerId: string): Set<string>;
+	recordOrigin(providerId: string, baseUrl: string | undefined): void;
+	resolveModel(providerId: string, modelId: string, signal: AbortSignal): Promise<Model<Api> | undefined>;
+}
+
+function originOf(url: string): string | undefined {
+	try {
+		return new URL(url).origin;
+	} catch {
+		return undefined;
+	}
+}
+
+/** Host side: serves executor requests with `runtime`'s catalog and the host's credential files. */
+export function serveModelExecutor(runtime: ModelRuntime, server: Server, options: ServeModelExecutorOptions = {}): void {
+	const agentDir = realpathSync(options.agentDir ?? getAgentDir());
+	// The store appears when the launcher migrates credentials, which can happen after startup.
+	const credentialStoreDirectory = () => {
+		if (options.credentialStore === undefined) return undefined;
+		try {
+			return realpathSync(options.credentialStore);
+		} catch {
+			return undefined;
+		}
+	};
+	const refreshedAt = new Map<string, number>();
+	const recorded = new Map<string, Set<string>>();
+	const state: ExecutorState = {
+		runtime,
+		refs: new CredentialRefRegistry(),
+		credentialFile(path, { create }) {
+			if (typeof path !== "string" || !isAbsolute(path)) throw new Error("Credential file path must be absolute");
+			const outside = () => new Error("Credential file is outside the agent directory's credential stores");
+			// The requested name must be one of the agent directory's credential files.
+			const requested = join(realpathSync(dirname(path)), basename(path));
+			const profiles = join(agentDir, "auth-profiles");
+			const relativeName =
+				requested === join(agentDir, "auth.json")
+					? "auth.json"
+					: dirname(requested) === profiles && /^[A-Za-z0-9._-]+\.json$/.test(basename(requested))
+						? join("auth-profiles", basename(requested))
+						: undefined;
+			if (relativeName === undefined) throw outside();
+			const credentialStore = credentialStoreDirectory();
+			const stored = credentialStore === undefined ? undefined : join(credentialStore, relativeName);
+			let entry: ReturnType<typeof lstatSync> | undefined;
+			try {
+				entry = lstatSync(requested);
+			} catch (error) {
+				if ((error as NodeJS.ErrnoException).code !== "ENOENT") throw error;
+			}
+			if (entry?.isSymbolicLink()) {
+				// Symlinks may only point into the credential store, at the file with the same name.
+				let target: string | undefined;
+				try {
+					target = realpathSync(requested);
+				} catch {
+					target = undefined;
+				}
+				if (stored === undefined || target !== stored) throw outside();
+				return stored;
+			}
+			if (entry !== undefined) return requested;
+			if (stored === undefined || !create) return requested;
+			// A new profile file is created in the store and linked, so the sandbox never sees its content.
+			try {
+				writeFileSync(stored, "{}", { flag: "wx", mode: 0o600 });
+			} catch (error) {
+				if ((error as NodeJS.ErrnoException).code !== "EEXIST") throw error;
+			}
+			symlinkSync(relative(dirname(requested), stored), requested);
+			return stored;
+		},
+		origins(providerId) {
+			const origins = new Set(recorded.get(providerId) ?? []);
+			const provider = runtime.getProvider(providerId);
+			for (const url of [provider?.baseUrl, ...runtime.getAllModels(providerId).map((model) => model.baseUrl)]) {
+				const origin = url ? originOf(url) : undefined;
+				if (origin) origins.add(origin);
+			}
+			return origins;
+		},
+		recordOrigin(providerId, baseUrl) {
+			const origin = baseUrl ? originOf(baseUrl) : undefined;
+			if (!origin) return;
+			const origins = recorded.get(providerId) ?? new Set<string>();
+			origins.add(origin);
+			recorded.set(providerId, origins);
+		},
+		// The sandbox names a model; the endpoint and request configuration come from the host catalog.
+		async resolveModel(providerId, modelId, signal) {
+			const model = runtime.getPhysicalModel(providerId, modelId);
+			if (model || !runtime.getProvider(providerId)) return model;
+			// The sandbox may have seen a newer remote catalog; refresh the host's copy at a bounded rate.
+			const now = Date.now();
+			if (now - (refreshedAt.get(providerId) ?? 0) < CATALOG_REFRESH_INTERVAL_MS) return undefined;
+			refreshedAt.set(providerId, now);
+			await runtime.refresh({ providers: [providerId], signal });
+			return runtime.getPhysicalModel(providerId, modelId);
+		},
+	};
+	server.on("connection", (socket) => {
+		void handleConnection(state, socket);
+	});
+}
