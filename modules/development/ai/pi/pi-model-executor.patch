+/** Rehydrates the sandbox's resolved auth for `providerId`; endpoint overrides must stay on known origins. */
+function requestAuth(state: ExecutorState, providerId: string, value: unknown): AuthResult {
+	if (!isRecord(value) || !isRecord(value.auth)) throw new Error(`Provider is not configured: ${providerId}`);
+	const auth: ModelAuth = {};
+	if (typeof value.auth.apiKey === "string") auth.apiKey = value.auth.apiKey;
+	const headers = isRecord(value.auth.headers) ? value.auth.headers : undefined;
+	if (headers) {
+		auth.headers = {};
+		for (const [name, header] of Object.entries(headers)) {
+			if (typeof header === "string" || header === null) auth.headers[name] = header;
+		}
+	}
+	if (typeof value.auth.baseUrl === "string") {
+		const origin = originOf(value.auth.baseUrl);
+		if (!origin || !state.origins(providerId).has(origin)) {
+			throw new Error(`Credential endpoint is not a known ${providerId} origin`);
+		}
+		auth.baseUrl = value.auth.baseUrl;
+	}
+	const env: Record<string, string> = {};
+	if (isRecord(value.env)) for (const [name, item] of Object.entries(value.env)) if (typeof item === "string") env[name] = item;
+	return state.refs.rehydrate(providerId, { auth, env }, { allowRefresh: false });
+}
+
+function configReferences(value: unknown, into = new Set<string>()): Set<string> {
+	if (typeof value === "string") {
+		if (isCommandConfigValue(value) || getConfigValueEnvVarNames(value).length > 0) into.add(value);
+	} else if (Array.isArray(value)) {
+		for (const item of value) configReferences(item, into);
+	} else if (isRecord(value)) {
+		for (const item of Object.values(value)) configReferences(item, into);
+	}
+	return into;
+}
+
+/**
+ * Credential values the host would execute (`!command`) or expand (`$VAR`) may come only from the
+ * host's own files, never from the sandbox: references carry the stored ones, and `allowed` lists
+ * values already on disk.
+ */
+function assertNoSandboxConfigReferences(value: unknown, allowed: ReadonlySet<string> = new Set()): void {
+	for (const reference of configReferences(value)) {
+		if (!allowed.has(reference)) throw new Error("Credential commands and environment references can only be set on the host");
+	}
+}
+
+/** A stored api-key credential's key may be a config reference (`!command`, `$VAR`) resolved on the host. */
+function resolvedCredential(credential: unknown): Credential | undefined {
+	if (!isRecord(credential) || (credential.type !== "api_key" && credential.type !== "oauth")) return undefined;
+	if (credential.type === "api_key" && typeof credential.key === "string") {
+		const env = isRecord(credential.env) ? (credential.env as Record<string, string>) : undefined;
+		return { ...(credential as unknown as ApiKeyCredential), key: resolveConfigValue(credential.key, env) };
+	}
+	return credential as unknown as Credential;
+}
+
+async function providerAuth(state: ExecutorState, frame: Frame, signal: AbortSignal): Promise<unknown> {
+	if (typeof frame.provider !== "string") throw new Error("Provider auth request must name a provider");
+	const providerId = frame.provider;
+	const provider = state.runtime.getProvider(providerId);
+	if (!provider) throw new Error(`Unknown provider: ${providerId}`);
+	assertNoSandboxConfigReferences(frame.credential);
+	const credential = resolvedCredential(
+		frame.credential === undefined ? undefined : state.refs.rehydrateCredential(providerId, frame.credential),
+	);
+	switch (frame.method) {
+		case "apiKey.resolve": {
+			if (!provider.auth.apiKey) throw new Error(`${providerId} has no API-key auth`);
+			const result = await provider.auth.apiKey.resolve({
+				ctx: defaultProviderAuthContext(),
+				credential: credential?.type === "api_key" ? credential : undefined,
+				signal,
+			});
+			if (!result) return null;
+			state.recordOrigin(providerId, result.auth.baseUrl);
+			return state.refs.redactAuthResult(providerId, result);
+		}
+		case "apiKey.check": {
+			const check = await provider.auth.apiKey?.check?.({
+				ctx: defaultProviderAuthContext(),
+				credential: credential?.type === "api_key" ? credential : undefined,
+				signal,
+			});
+			return check ? { type: check.type, ...(check.source === undefined ? {} : { source: check.source }) } : null;
+		}
+		case "oauth.refresh": {
+			if (!provider.auth.oauth || credential?.type !== "oauth") throw new Error(`${providerId} has no OAuth credential to refresh`);
+			return state.refs.redactCredential(providerId, await provider.auth.oauth.refresh(credential, signal));
+		}
+		case "oauth.toAuth": {
+			if (!provider.auth.oauth || credential?.type !== "oauth") throw new Error(`${providerId} has no OAuth credential`);
+			const auth = await provider.auth.oauth.toAuth(credential);
+			state.recordOrigin(providerId, auth.baseUrl);
+			return state.refs.redactModelAuth(providerId, auth);
+		}
+		default:
+			throw new Error("Unsupported provider auth method");
+	}
+}
+
+/** Substitutes references in `value`, which may only reach `origin` for their providers. */
+function substituteForOrigin(state: ExecutorState, value: string, origin: string, used: Set<string>): string {
+	let result = value;
+	for (const providerId of state.refs.providersIn(value)) {
+		if (!state.origins(providerId).has(origin)) throw new Error(`${providerId} credentials cannot be sent to ${origin}`);
+		const rehydrated = state.refs.rehydrateString(providerId, result, { allowRefresh: false });
+		for (const secret of state.refs.secrets()) if (rehydrated.includes(secret) && !result.includes(secret)) used.add(secret);
+		result = rehydrated;
+	}
+	return result;
+}
+
+/**
+ * Replaces secrets in a byte stream. Only a tail that could begin a secret is held back, so a
+ * secret split across chunks is still caught without delaying ordinary output.
+ */
+function streamScrubber(secrets: readonly string[]): { push(chunk: Buffer): Buffer; flush(): Buffer } {
+	const encoded = secrets.map((secret) => Buffer.from(secret, "utf8").toString("latin1"));
+	let pending = "";
+	const scrub = (text: string) => encoded.reduce((current, secret) => current.split(secret).join(REDACTED), text);
+	const partialSecretTail = (text: string) => {
+		let keep = 0;
+		for (const secret of encoded) {
+			for (let length = Math.min(secret.length - 1, text.length); length > keep; length--) {
+				if (text.endsWith(secret.slice(0, length))) {
+					keep = length;
+					break;
+				}
+			}
+		}
+		return keep;
+	};
+	return {
+		push(chunk) {
+			if (encoded.length === 0) return chunk;
+			pending = scrub(pending + chunk.toString("latin1"));
+			const keep = partialSecretTail(pending);
+			const ready = pending.slice(0, pending.length - keep);
+			pending = pending.slice(pending.length - keep);
+			return Buffer.from(ready, "latin1");
+		},
+		flush() {
+			const rest = scrub(pending);
+			pending = "";
+			return Buffer.from(rest, "latin1");
+		},
+	};
+}
+
+/**
+ * Sends a sandbox request that carries credential references in its URL or headers, only to
+ * those credentials' origins, and streams the response back with the secrets scrubbed.
+ */
+async function credentialedFetch(
+	state: ExecutorState,
+	frame: Frame,
+	send: (frame: Frame) => Promise<void>,
+	signal: AbortSignal,
+): Promise<void> {
+	if (typeof frame.url !== "string" || !Array.isArray(frame.headers)) throw new Error("Invalid credentialed request");
+	const target = new URL(frame.url);
+	if (target.protocol !== "https:" && target.protocol !== "http:") throw new Error("Credentialed requests must use HTTP");
+	const used = new Set<string>();
+	const url = substituteForOrigin(state, frame.url, target.origin, used);
+	const headers = new Headers();
+	for (const entry of frame.headers) {
+		if (!Array.isArray(entry) || typeof entry[0] !== "string" || typeof entry[1] !== "string") continue;
+		headers.append(entry[0], substituteForOrigin(state, entry[1], target.origin, used));
+	}
+	const body = typeof frame.body === "string" ? Buffer.from(frame.body, "base64") : undefined;
+	// Redirects come back to the sandbox, whose next request is checked against the same origins.
+	const response = await fetch(url, {
+		method: typeof frame.method === "string" ? frame.method : "GET",
+		headers,
+		...(body ? { body } : {}),
+		redirect: "manual",
+		signal,
+	});
+	const secrets = [...used];
+	const scrubber = streamScrubber(secrets);
+	await send({
+		type: "head",
+		status: response.status,
+		statusText: response.statusText,
+		headers: [...response.headers].map(([name, value]) => [
+			name,
+			secrets.reduce((scrubbed, secret) => scrubbed.split(secret).join(REDACTED), value),
+		]),
+	});
+	const reader = response.body?.getReader();
+	while (reader) {
+		const { done, value } = await reader.read();
+		if (done) break;
+		const ready = scrubber.push(Buffer.from(value));
+		if (ready.length > 0) await send({ type: "body", data: ready.toString("base64") });
+	}
+	const rest = scrubber.flush();
+	if (rest.length > 0) await send({ type: "body", data: rest.toString("base64") });
+	await send({ type: "end" });
+}
+
+/** Runs a provider login on the host; the sandbox relays prompts and receives only references. */
+async function login(state: ExecutorState, frame: Frame, session: ExecutorSession, signal: AbortSignal): Promise<unknown> {
+	if (typeof frame.provider !== "string") throw new Error("Login request must name a provider");
+	const providerId = frame.provider;
+	const provider = state.runtime.getProvider(providerId);
+	if (!provider) throw new Error(`Unknown provider: ${providerId}`);
+	let nextPrompt = 0;
+	const interaction: ProviderAuthInteraction = {
+		signal,
+		async prompt(prompt: AuthPrompt) {
+			const id = ++nextPrompt;
+			const { signal: promptSignal, ...rest } = prompt;
+			const cancel = () => void session.send({ type: "prompt_cancel", id }).catch(() => {});
+			promptSignal?.addEventListener("abort", cancel, { once: true });
+			try {
+				await session.send({ type: "prompt", id, prompt: rest });
+				const reply = await session.next();
+				if (!reply || reply.type !== "prompt_result" || reply.id !== id) throw new Error("Login prompt was not answered");
+				if (typeof reply.error === "string") throw new Error(reply.error);
+				if (typeof reply.value !== "string") throw new Error("Login prompt returned no value");
+				return reply.value;
+			} finally {
+				promptSignal?.removeEventListener("abort", cancel);
+			}
+		},
+		notify(event: AuthEvent) {
+			void session.send({ type: "notify", event }).catch(() => {});
+		},
+	};
+	const loginOptions: LoginOptions = {
+		...(typeof frame.agentName === "string" ? { agentName: frame.agentName } : {}),
+		...(typeof frame.deviceId === "string" ? { getDeviceId: () => frame.deviceId as string } : {}),
+	};
+	let credential: Credential;
+	if (frame.kind === "oauth" && provider.auth.oauth) credential = await provider.auth.oauth.login(interaction, loginOptions);
+	else if (frame.kind === "apiKey" && provider.auth.apiKey?.login) credential = await provider.auth.apiKey.login(interaction);
+	else throw new Error(`${providerId} does not support this login`);
+	return state.refs.redactCredential(providerId, credential);
+}
+
+function redactCredentialFile(state: ExecutorState, content: string | undefined): string | null {
+	if (content === undefined || content.trim() === "") return null;
+	const data = JSON.parse(content) as Record<string, unknown>;
+	return JSON.stringify(
+		Object.fromEntries(
+			Object.entries(data).map(([providerId, credential]) => [providerId, state.refs.redactCredential(providerId, credential)]),
+		),
+	);
+}
+
+/**
+ * Reads without the file lock: locking every read serializes concurrent availability checks.
+ * Writers rewrite the file in place, so a torn read falls back to a locked one.
+ */
+async function credentialRead(state: ExecutorState, frame: Frame, signal: AbortSignal): Promise<string | null> {
+	const path = state.credentialFile(frame.path, { create: false });
+	let content: string | undefined;
+	try {
+		content = await readFile(path, "utf8");
+	} catch (error) {
+		if ((error as NodeJS.ErrnoException).code !== "ENOENT") throw error;
+	}
+	try {
+		return redactCredentialFile(state, content);
+	} catch (error) {
+		if (!(error instanceof SyntaxError)) throw error;
+		const locked = await new FileAuthStorageBackend(path).withLockAsync(async (current) => ({ result: current }), { signal });
+		return redactCredentialFile(state, locked);
+	}
+}
+
+/**
+ * Holds a credential file's lock while the sandbox reads and rewrites it. The sandbox sees
+ * references in place of secrets; references in its rewrite turn back into the stored secrets.
+ */
+async function credentialLock(state: ExecutorState, frame: Frame, session: ExecutorSession, signal: AbortSignal): Promise<void> {
+	const path = state.credentialFile(frame.path, { create: true });
+	await new FileAuthStorageBackend(path).withLockAsync(
+		async (content) => {
+			await session.send({ type: "content", content: redactCredentialFile(state, content) });
+			const reply = await session.next();
+			if (!reply || reply.type === "abort") return { result: undefined };
+			if (reply.type !== "commit") throw new Error("Unexpected credential lock frame");
+			if (typeof reply.next !== "string") return { result: undefined };
+			const next = JSON.parse(reply.next) as unknown;
+			if (!isRecord(next)) throw new Error("Credential file must hold an object");
+			assertNoSandboxConfigReferences(next, configReferences(content ? (JSON.parse(content) as unknown) : undefined));
+			const rehydrated = Object.fromEntries(
+				Object.entries(next).map(([providerId, credential]) => [providerId, state.refs.rehydrateCredential(providerId, credential)]),
+			);
+			return { result: undefined, next: JSON.stringify(rehydrated, null, 2) };
+		},
+		{ signal },
+	);
+}
+
+interface ExecutorSession {
+	send(frame: Frame): Promise<void>;
+	next(): Promise<Frame | undefined>;
+}
+
+async function handleConnection(state: ExecutorState, socket: Socket): Promise<void> {
+	const { runtime } = state;
+	const controller = new AbortController();
+	const waiting = new Map<CallbackKind, Array<{ resolve: (frame: Frame) => void; reject: (error: Error) => void }>>();
+	const incoming = new FrameQueue();
+	let session = false;
+	let secrets: string[] = [];
+	const scrub = (text: string) => {
+		let scrubbed = text;
+		for (const secret of secrets) scrubbed = scrubbed.split(secret).join(REDACTED);
+		return scrubbed;
+	};
+	const rejectWaiting = (error: Error) => {
+		for (const queue of waiting.values()) for (const waiter of queue.splice(0)) waiter.reject(error);
+	};
+	let request: Frame | undefined;
+	let resolveRequest: ((frame: Frame) => void) | undefined;
+	const requested = new Promise<Frame>((resolve) => {
+		resolveRequest = resolve;
+	});
+	const close = (error: Error) => {
+		controller.abort(error);
+		rejectWaiting(error);
+		incoming.fail(error);
+		socket.destroy();
+	};
+	readFrames(
+		socket,
+		(frame) => {
+			if (!request) {
+				request = frame;
+				resolveRequest?.(frame);
+				return;
+			}
+			if (frame.type === "cancel") {
+				controller.abort(new Error("Request cancelled by the sandbox"));
+				return;
+			}
+			if (session) {
+				incoming.push(frame);
+				return;
+			}
+			const match = /^(headers|payload|response|provider_event)_result$/.exec(frame.type);
+			const waiter = match ? waiting.get(match[1] as CallbackKind)?.shift() : undefined;
+			if (!waiter) return close(new Error("Unexpected model executor frame"));
+			if (typeof frame.error === "string") waiter.reject(new Error(frame.error));
+			else waiter.resolve(frame);
+		},
+		close,
+	);
+	socket.on("error", () => {});
+	socket.once("close", () => {
+		const error = new Error("Model executor client disconnected");
+		controller.abort(error);
+		rejectWaiting(error);
+		incoming.close();
+		resolveRequest?.({ type: "closed" });
+	});
+	const send = (frame: Frame) => writeFrame(socket, frame, scrub);
+	const fail = async (error: unknown) => {
+		await send({ type: "failure", message: errorMessage(error) }).catch(() => {});
+		socket.end();
+	};
+
+	const frame = await requested;
+	if (frame.type === "closed") return;
+	if (frame.type !== "request" || frame.protocol !== PROTOCOL) return fail(new Error("Unsupported model executor request"));
+	// Every reply is scrubbed of every secret the executor has issued a reference for.
+	secrets = state.refs.secrets();
+	try {
+		switch (frame.operation) {
+			case "streamSimple":
+				break;
+			case "credential_read": {
+				const value = await credentialRead(state, frame, controller.signal);
+				await writeFrame(socket, { type: "result", value });
+				socket.end();
+				return;
+			}
+			case "provider_auth": {
+				const value = await providerAuth(state, frame, controller.signal);
+				await send({ type: "result", value: value ?? null });
+				socket.end();
+				return;
+			}
+			case "fetch": {
+				// The fetch scrubs the secrets it substituted; the response itself is the provider's.
+				await credentialedFetch(state, frame, (reply) => writeFrame(socket, reply), controller.signal);
+				socket.end();
+				return;
+			}
+			case "login":
+			case "credential_lock": {
+				session = true;
+				const channel: ExecutorSession = { send, next: () => incoming.next() };
+				if (frame.operation === "login") {
+					const value = await login(state, frame, channel, controller.signal);
+					// The login's own secrets were just registered; scrub them from the result frame too.
+					secrets = [];
+					await writeFrame(socket, { type: "result", value });
+				} else {
+					await credentialLock(state, frame, { send: (reply) => writeFrame(socket, reply), next: channel.next }, controller.signal);
+					await writeFrame(socket, { type: "done" });
+				}
+				socket.end();
+				return;
+			}
+			default:
+				throw new Error("Unsupported model executor operation");
+		}
+	} catch (error) {
+		return fail(error);
+	}
+
+	let parsed: ReturnType<typeof parseRequest>;
+	let model: Model<Api> | undefined;
+	let auth: AuthResult;
+	try {
+		parsed = parseRequest(frame);
+		model = await state.resolveModel(parsed.provider, parsed.modelId, controller.signal);
+		if (!model) throw new Error(`Unknown model: ${parsed.provider}/${parsed.modelId}`);
+		auth = requestAuth(state, model.provider, parsed.auth);
+	} catch (error) {
+		return fail(error);
+	}
+	const { context, callbacks } = parsed;
+	const options: ModelsSimpleStreamOptions = {
+		...(parsed.options as ModelsSimpleStreamOptions),
+		signal: controller.signal,
+		transformHeaders: async (headers) => {
+			// The sandbox's own header options were filtered, so credential headers here are the host's.
+			const protectedHeaders: ProviderHeaders = {};
+			for (const [name, value] of Object.entries(headers)) if (isCredentialHeader(name)) protectedHeaders[name] = value;
+			let result = headers;
+			if (callbacks.headers) {
+				const visible: ProviderHeaders = { ...headers };
+				for (const name of Object.keys(protectedHeaders)) if (name in visible) visible[name] = REDACTED;
