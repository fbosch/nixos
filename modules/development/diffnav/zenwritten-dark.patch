+package common
+
+import tint "github.com/lrstanley/bubbletint/v2"
+
+// Matches dotfiles/.config/fbb/data/palette.json, zenwritten.dark.
+var tintZenwrittenDark = &tint.Tint{
+	DisplayName:  "Zenwritten Dark",
+	ID:           "zenwritten_dark",
+	Dark:         true,
+	Fg:           tint.FromHex("#BBBBBB"),
+	Bg:           tint.FromHex("#191919"),
+	SelectionBg:  tint.FromHex("#404040"),
+	Cursor:       tint.FromHex("#C9C9C9"),
+	Black:        tint.FromHex("#191919"),
+	Red:          tint.FromHex("#DE6E7C"),
+	Green:        tint.FromHex("#819B69"),
+	Yellow:       tint.FromHex("#B77E64"),
+	Blue:         tint.FromHex("#6099C0"),
+	Purple:       tint.FromHex("#B279A7"),
+	Cyan:         tint.FromHex("#66A5AD"),
+	White:        tint.FromHex("#BBBBBB"),
+	BrightBlack:  tint.FromHex("#3D3839"),
+	BrightRed:    tint.FromHex("#E8838F"),
+	BrightGreen:  tint.FromHex("#8BAE68"),
+	BrightYellow: tint.FromHex("#D68C67"),
+	BrightBlue:   tint.FromHex("#61ABDA"),
+	BrightPurple: tint.FromHex("#CF86C1"),
+	BrightCyan:   tint.FromHex("#65B8C1"),
+	BrightWhite:  tint.FromHex("#8E8E8E"),
+}
