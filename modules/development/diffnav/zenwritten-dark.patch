@@ -0,0 +1,29 @@
+package common
+
+import "testing"
+
+func TestZenwrittenDark(t *testing.T) {
+	previous := Themes
+	t.Cleanup(func() { Themes = previous })
+	RegisterSupportedTints()
+	if !Themes.SetTintID("zenwritten_dark") {
+		t.Fatal("Zenwritten Dark is not registered")
+	}
+	theme := Themes.Current()
+	if theme.ID != "zenwritten_dark" || !theme.Dark {
+		t.Fatal("Zenwritten Dark did not activate as a dark theme")
+	}
+	if got := SupportedThemeToDeltaSyntax[theme.ID]; got != "Zenwritten Dark" {
+		t.Fatalf("delta syntax theme = %q, want Zenwritten Dark", got)
+	}
+	if got := LipglossColorToHex(theme.Bg); got != "#191919" {
+		t.Fatalf("background = %s, want #191919", got)
+	}
+	if got := LipglossColorToHex(theme.Fg); got != "#bbbbbb" {
+		t.Fatalf("foreground = %s, want #bbbbbb", got)
+	}
+	styles := MakeStyles()
+	if got := LipglossColorToHex(styles.Colors.SelectionBg); got != "#404040" {
+		t.Fatalf("selection background = %s, want #404040", got)
+	}
+}
