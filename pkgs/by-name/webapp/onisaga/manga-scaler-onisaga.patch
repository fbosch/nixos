diff --git a/onisaga-adapter.js b/onisaga-adapter.js
new file mode 100644
--- /dev/null
+++ b/onisaga-adapter.js
@@ -0,0 +1,77 @@
+(() => {
+  const isOniSagaHost = (hostname) => /(^|\.)onisaga\.com$/i.test(hostname);
+
+  const isReaderPage = (url = window.location.href) => {
+    try {
+      const parsed = new URL(url);
+      return isOniSagaHost(parsed.hostname) && /^\/read\/[^/]+\/\d+\/?$/i.test(parsed.pathname);
+    } catch {
+      return false;
+    }
+  };
+
+  const sourceFor = (image) => image.currentSrc || image.dataset.src || image.getAttribute("src") || "";
+
+  const pageNumberFor = (image) => {
+    const match = String(image?.alt || "").match(/\bPage\s+(\d+)\s*$/i);
+    return match ? Number(match[1]) : null;
+  };
+
+  const readerImages = () =>
+    Array.from(document.images).filter(
+      (image) => pageNumberFor(image) !== null && sourceFor(image).startsWith("blob:https://onisaga.com/")
+    );
+
+  const chapterId = () => new URL(window.location.href).pathname.replace(/\/+$/, "");
+
+  const onisagaSourceAdapter = {
+    id: "onisaga",
+    isReaderPageUrl: isReaderPage,
+    parseImageUrl(url) {
+      let parsed;
+      try {
+        parsed = new URL(url, window.location.href);
+      } catch {
+        return null;
+      }
+
+      const image = readerImages().find((image) => {
+        try {
+          return new URL(sourceFor(image), window.location.href).href === parsed.href;
+        } catch {
+          return false;
+        }
+      });
+      const page = pageNumberFor(image);
+      if (page === null) return null;
+
+      return {
+        parsedUrl: parsed,
+        page,
+        pageKey: `${chapterId()}/${page}`,
+      };
+    },
+    getActiveContainer() {
+      return document.body;
+    },
+    selectForegroundImage() {
+      const visible = readerImages().find((image) => {
+        const style = window.getComputedStyle(image);
+        const rect = image.getBoundingClientRect();
+        return (
+          rect.width > 0 &&
+          rect.height > 0 &&
+          style.display !== "none" &&
+          style.visibility !== "hidden" &&
+          rect.bottom >= 0 &&
+          rect.top <= window.innerHeight
+        );
+      });
+
+      return visible || readerImages().find((image) => image.dataset.aiProcessedSrc !== sourceFor(image)) || null;
+    },
+  };
+
+  window.NHScalerSourceAdapters = window.NHScalerSourceAdapters || [];
+  window.NHScalerSourceAdapters.push(onisagaSourceAdapter);
+})();
