+fn idle_registration(
+  fx: &Fixture,
+  argv: &[&str],
+  cwd: &std::path::Path,
+  label: &str,
+  start: bool,
+) -> TaskRegistration {
+  let mut spec =
+    ProcessSpec::from_argv(argv.iter().map(|s| s.to_string()).collect());
+  spec.cwd(cwd.to_string_lossy().into_owned());
+  let tx = fx.tx.clone();
+  TaskRegistration {
+    task_id: fx.pc.alloc_id(),
+    def: TaskDef {
+      process_spec: Some(spec),
+      pinned: start,
+      label: Some(label.to_string()),
+      ..path_def("registered")
+    },
+    factory: Box::new(move |ctx| {
+      Box::new(RecordingTask {
+        name: "registered",
+        tx,
+        ctx,
+      })
+    }),
+  }
+}
