+#[tokio::test]
+async fn register_idle_preserves_identity_label_and_running_child() {
+  let mut fx = Fixture::new();
+  let cwd = std::env::current_dir().unwrap();
+  let handle = fx.run();
+  fx.pc
+    .register_idle_task(
+      idle_registration(&fx, &["tool", "a b"], &cwd, "original", false),
+      false,
+    )
+    .await
+    .unwrap()
+    .unwrap();
+  fx.flush().await;
+  fx.assert_no_cmd();
+  let first = idle_registration_info(&fx).await;
+  assert_eq!(first.state, TaskState::Idle);
+  assert_eq!(first.label.as_deref(), Some("original"));
+
+  fx.pc
+    .register_idle_task(
+      idle_registration(
+        &fx,
+        &["tool", "a b"],
+        &cwd.join("."),
+        "renamed request",
+        false,
+      ),
+      false,
+    )
+    .await
+    .unwrap()
+    .unwrap();
+  fx.flush().await;
+  fx.assert_no_cmd();
+  assert_eq!(idle_registration_info(&fx).await.id, first.id);
+
+  fx.pc
+    .register_idle_task(
+      idle_registration(&fx, &["tool", "a b"], &cwd, "ignored", true),
+      true,
+    )
+    .await
+    .unwrap()
+    .unwrap();
+  assert_eq!(fx.recv().await, ("registered", RecordedCmd::Start));
+  fx.flush().await;
+  let running = idle_registration_info(&fx).await;
+  assert_eq!(running.id, first.id);
+  assert_eq!(running.state, TaskState::Ready);
+  for start in [false, true] {
+    fx.pc
+      .register_idle_task(
+        idle_registration(&fx, &["tool", "a b"], &cwd, "ignored", start),
+        start,
+      )
+      .await
+      .unwrap()
+      .unwrap();
+    fx.flush().await;
+    fx.assert_no_cmd();
+    let current = idle_registration_info(&fx).await;
+    assert_eq!(current.id, first.id);
+    assert_eq!(current.state, TaskState::Ready);
+    assert_eq!(current.label.as_deref(), Some("original"));
+  }
+  fx.quit(handle).await;
+}
