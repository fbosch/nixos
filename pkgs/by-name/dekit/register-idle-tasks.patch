+#[tokio::test]
+async fn register_idle_conflicts_never_start_or_replace_task() {
+  let mut fx = Fixture::new();
+  let cwd = std::env::current_dir().unwrap();
+  let handle = fx.run();
+  fx.pc
+    .register_idle_task(
+      idle_registration(&fx, &["tool", "one"], &cwd, "original", false),
+      false,
+    )
+    .await
+    .unwrap()
+    .unwrap();
+  let first = idle_registration_info(&fx).await;
+  for start in [false, true] {
+    for (argv, directory) in [
+      (vec!["tool", "different"], cwd.clone()),
+      (vec!["tool", "one"], cwd.join("src")),
+    ] {
+      let result = fx
+        .pc
+        .register_idle_task(
+          idle_registration(&fx, &argv, &directory, "conflict", start),
+          start,
+        )
+        .await
+        .unwrap();
+      assert!(matches!(result, Err(RegisterError::DefinitionConflict(_))));
+      fx.flush().await;
+      fx.assert_no_cmd();
+      let current = idle_registration_info(&fx).await;
+      assert_eq!(current.id, first.id);
+      assert_eq!(current.state, TaskState::Idle);
+      assert_eq!(current.label.as_deref(), Some("original"));
+    }
+  }
+  fx.quit(handle).await;
+}
