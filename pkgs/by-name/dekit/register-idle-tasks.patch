+fn same_process(old: &ProcessSpec, new: &ProcessSpec) -> bool {
+  fn canonical_cwd(spec: &ProcessSpec) -> Option<std::path::PathBuf> {
+    let cwd = spec.cwd.as_deref().map(std::path::Path::new);
+    match cwd {
+      Some(cwd) => dunce::canonicalize(cwd).ok(),
+      None => std::env::current_dir()
+        .ok()
+        .and_then(|cwd| dunce::canonicalize(cwd).ok()),
+    }
+  }
+  old.prog == new.prog
+    && old.args == new.args
+    && canonical_cwd(old)
+      .zip(canonical_cwd(new))
+      .is_some_and(|(a, b)| a == b)
+}
