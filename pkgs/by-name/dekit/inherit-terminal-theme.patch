+mod tests {
+  use super::*;
+  use crate::term::{Color, Size};
+
+  #[test]
+  fn terminal_theme_preserves_task_colors_and_attributes() {
+    let size = Size {
+      width: 14,
+      height: 1,
+    };
+    let mut screen = Screen::new(size, 0);
+    screen.process(
+      b"D\x1b[31mR\x1b[94mB\x1b[38;5;196mX\x1b[38;2;18;52;86;48;2;8;16;24mT\x1b[0;1;7mV\x1b[0m\xe7\x95\x8c",
+      &mut Vec::new(),
+    );
+    let mut grid = Grid::new(size, 0);
+    render_screen(&screen, Rect::new(0, 0, size.width, 1), &mut grid, None);
+    for col in 0..size.width {
+      let original = screen.cell(0, col).unwrap();
+      let rendered = grid.drawing_cell_mut(Pos { col, row: 0 }).unwrap();
+      assert_eq!(rendered.attrs(), original.attrs());
+      if original.has_contents() {
+        assert_eq!(rendered.contents(), original.contents());
+      }
+    }
+    assert_eq!(screen.cell(0, 0).unwrap().attrs().fgcolor, Color::Default);
+    assert_eq!(screen.cell(0, 1).unwrap().attrs().fgcolor, Color::Idx(1));
+    assert_eq!(screen.cell(0, 2).unwrap().attrs().fgcolor, Color::Idx(12));
+    assert_eq!(screen.cell(0, 3).unwrap().attrs().fgcolor, Color::Idx(196));
+    assert_eq!(
+      screen.cell(0, 4).unwrap().attrs().fgcolor,
+      Color::Rgb(18, 52, 86)
+    );
+    assert!(screen.cell(0, 5).unwrap().attrs().inverse());
+  }
+}
