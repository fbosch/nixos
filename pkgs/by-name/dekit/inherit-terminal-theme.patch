+  fn blends_only_when_both_colors_have_explicit_rgb_values() {
+    assert_eq!(Color::Default.blend(Color::Idx(8), 128), Color::Default);
+    assert_eq!(Color::Idx(2).blend(Rgb(0, 0, 0), 128), Color::Idx(2));
+    assert_eq!(
+      Color::Rgb(18, 52, 86).blend(Color::Default, 128),
+      Color::Rgb(18, 52, 86)
+    );
+    assert_eq!(
+      Color::Rgb(0, 0, 0).blend(Color::Rgb(255, 255, 255), 128),
+      Color::Rgb(128, 128, 128)
+    );
+  }
