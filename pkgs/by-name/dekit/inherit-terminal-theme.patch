+#[cfg(test)]
+mod tests {
+  use super::*;
+
+  #[test]
+  fn terminal_theme_keeps_default_and_indexed_colors() {
+    let theme = Theme::terminal();
+    assert!(theme.palette.is_none());
+    let panel = theme.block.panel(true);
+    assert_eq!(panel.text.fgcolor, Color::Default);
+    assert_eq!(panel.text.bgcolor, Color::Default);
+    assert_eq!(panel.border.fgcolor, Color::Idx(6));
+    assert_eq!(theme.tasks.up, Color::Idx(2));
+    assert_eq!(theme.tasks.failed, Color::Idx(1));
+  }
+
+  #[test]
+  fn terminal_selection_reverses_the_terminals_own_colors() {
+    let theme = Theme::terminal();
+    let normal = theme.block.modal();
+    let selected = theme.block.modal_row(normal, true);
+    assert!(!normal.text.inverse());
+    assert!(selected.text.inverse());
+    assert_eq!(selected.text.fgcolor, Color::Default);
+    assert_eq!(selected.text.bgcolor, Color::Default);
+  }
+
+  #[test]
+  fn attachments_resolve_the_same_symbolic_color_independently() {
+    let theme = Theme::terminal();
+    let mut first = Theme::dark().palette.unwrap();
+    let mut second = Theme::light().palette.unwrap();
+    first.ansi[2] = Rgb(129, 155, 105);
+    second.ansi[2] = Rgb(0, 128, 0);
+    assert_eq!(first.fg(theme.tasks.up), Rgb(129, 155, 105));
+    assert_eq!(second.fg(theme.tasks.up), Rgb(0, 128, 0));
+    assert_eq!(first.fg(theme.block.text), first.fg);
+    assert_eq!(second.bg(theme.block.bg), second.bg);
+  }
+}
